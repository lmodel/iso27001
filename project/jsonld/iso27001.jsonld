    }
  ],
  "default_prefix": "iso27001",
  "default_range": "string",
  "subsets": [
    {
      "name": "isms_core",
      "definition_uri": "https://w3id.org/lmodel/iso27001/IsmsCore",
      "description": "The records of the ISMS's context, leadership, planning and support (clauses 4 to 7).",
      "from_schema": "https://w3id.org/lmodel/iso27001",
      "@type": "SubsetDefinition"
    },
    {
      "name": "isms_risk_management",
      "definition_uri": "https://w3id.org/lmodel/iso27001/IsmsRiskManagement",
      "description": "The records of risk assessment and risk treatment (clauses 6.1.2, 6.1.3, 8.2 and 8.3).",
      "from_schema": "https://w3id.org/lmodel/iso27001",
      "@type": "SubsetDefinition"
    },
    {
      "name": "isms_annex_a",
      "definition_uri": "https://w3id.org/lmodel/iso27001/IsmsAnnexA",
      "description": "The Annex A reference controls, the organization's controls and the Statement of Applicability, and the records Annex A controls call for.",
      "from_schema": "https://w3id.org/lmodel/iso27001",
      "@type": "SubsetDefinition"
    },
    {
      "name": "isms_performance_evaluation",
      "definition_uri": "https://w3id.org/lmodel/iso27001/IsmsPerformanceEvaluation",
      "description": "The records of monitoring, internal audit and management review (clause 9).",
      "from_schema": "https://w3id.org/lmodel/iso27001",
      "@type": "SubsetDefinition"
    },
    {
      "name": "isms_improvement",
      "definition_uri": "https://w3id.org/lmodel/iso27001/IsmsImprovement",
      "description": "The records of continual improvement, nonconformity and corrective action (clause 10).",
      "from_schema": "https://w3id.org/lmodel/iso27001",
      "@type": "SubsetDefinition"
    },
    {
      "name": "isms_documented_information",
      "definition_uri": "https://w3id.org/lmodel/iso27001/IsmsDocumentedInformation",
      "description": "The records that are documented information under document control (clause 7.5).",
      "from_schema": "https://w3id.org/lmodel/iso27001",
      "@type": "SubsetDefinition"
    }
  ],
  "types": [
    {
      "name": "isms_duration",
      "definition_uri": "https://w3id.org/lmodel/iso27001/IsmsDuration",
      "description": "A length of time as ISO 8601 writes it, such as P7Y for seven years or P30D for thirty days.",
      "from_schema": "https://w3id.org/lmodel/iso27001",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#duration",
      "pattern": "^P(?=[0-9T])([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$",
      "@type": "TypeDefinition"
    },
    {
      "name": "isms_requirement_reference",
      "definition_uri": "https://w3id.org/lmodel/iso27001/IsmsRequirementReference",
      "description": "The number of a clause of ISO/IEC 27001:2022, from 4 to 10, such as 6.1.2, or of an Annex A control, such as A.5.9.",
      "from_schema": "https://w3id.org/lmodel/iso27001",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^(([4-9]|10)(\\.[0-9]{1,2}){0,2}|A\\.[5-8]\\.[0-9]{1,2})$",
      "@type": "TypeDefinition"
    },
    {
      "name": "string",
      "definition_uri": "https://w3id.org/linkml/String",
      "description": "A character string",
      "notes": [
        "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Text"
      ],
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
