      "definition_uri": "https://w3id.org/lmodel/iso27001/IsmsIncludedControl",
      "description": "An entry that includes a control the organization needs, from Annex A or from elsewhere, and says whether it is in place.",
      "comments": [
        "An included control names an Annex A control, one of the organization's controls, or both."
      ],
      "in_subset": [
        "isms_annex_a"
      ],
      "from_schema": "https://w3id.org/lmodel/iso27001",
