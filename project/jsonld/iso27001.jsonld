      "definition_uri": "https://w3id.org/lmodel/iso27001/IsmsControl",
      "annotations": [
        {
          "tag": "iso27001_clause",
          "value": "6.1.3",
          "@type": "Annotation"
        }
      ],
      "description": "A control the organization has determined it needs to treat its risks: what it does in the organization's words, which Annex A controls it answers to, who owns it, how far it is in place and how well it works.",
