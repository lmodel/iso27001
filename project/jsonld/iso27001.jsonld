      "annotations": [
        {
          "tag": "iso27001_clause",
          "value": "6.1.3",
          "@type": "Annotation"
        }
      ],
      "description": "One entry of the Statement of Applicability, which either includes a control or excludes an Annex A control, and says why.",
      "in_subset": [
        "isms_annex_a"
      ],
      "from_schema": "https://w3id.org/lmodel/iso27001",
