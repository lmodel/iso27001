        "ismsApplicabilityEntry__entry_justification"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "entry_type",
          "description": "The kind of entry: IsmsIncludedControl or IsmsExcludedControl.",
          "designates_type": true,
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "entry_justification",
          "description": "Why the control is included or excluded.",
          "required": true,
          "pattern": "^\\s*\\S",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/iso27001/IsmsApplicabilityEntry",
      "@type": "ClassDefinition"
    },
