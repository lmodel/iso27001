        "ismsDocumentControlMixin__document_storage",
        "ismsDocumentControlMixin__document_change_control",
        "ismsDocumentControlMixin__document_external_origin",
        "ismsDocumentControlMixin__document_external_source"
      ],
      "slot_usage": {},
