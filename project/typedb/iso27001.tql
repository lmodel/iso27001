      owns context-changes,
      owns interested-party-changes,
      owns interested-party-feedback,
      owns performance-trends,
      owns audit-results-summary,
      owns risk-assessment-results,
      owns risk-treatment-status,
      owns risks-and-opportunities-changes,
      owns improvement-opportunities @card(0..),
      owns decisions @card(0..),
      owns action-items @card(0..),
      owns next-review-date,
      plays management-reviews:managementreview;
  
  entity nonconformity, sub namedentity,
      owns nonconformity-source,
      owns detection-date,
      owns detected-by,
      owns requirement-violated,
      owns nonconformity-description,
      owns immediate-actions @card(0..),
      owns consequences-addressed,
      owns root-cause,
      owns similar-nonconformities-check,
      owns status,
      owns closure-date,
      owns closure-evidence,
      plays nonconformities:nonconformity,
      plays linked-corrective-actions:nonconformity,
      plays linked-nonconformity:nonconformity;
  
  entity correctiveaction, sub namedentity,
      owns action-description,
      owns root-cause-addressed,
      owns responsible-party,
      owns target-completion-date,
      owns actual-completion-date,
      owns resources-required,
      owns effectiveness-criteria,
      owns effectiveness-review-date,
      owns effectiveness-verified,
      owns isms-changes-required,
      owns status,
      plays corrective-actions:correctiveaction,
      plays linked-corrective-action:correctiveaction,
      plays linked-corrective-actions:correctiveaction,
      plays linked-nonconformity:correctiveaction;
  
  entity improvementopportunity, sub namedentity,
      owns improvement-source,
      owns identification-date,
      owns identified-by,
      owns improvement-description,
      owns expected-benefit,
      owns priority,
      owns implementation-plan,
      owns responsible-party,
      owns target-date,
      owns actual-completion-date,
      owns outcome-assessment,
      owns status,
      plays improvements:improvementopportunity;
  
  entity asset, sub namedentity,
      owns asset-type,
      owns asset-owner,
      owns asset-custodian,
      owns classification,
      owns location,
      owns criticality,
      plays affected-assets:asset,
      plays related-risks:asset,
      plays applicable-controls:asset;
  
  entity informationsecurityevent, sub namedentity,
      owns event-datetime,
      owns reporter,
      owns event-description,
      owns initial-assessment,
      owns categorized-as-incident,
      plays affected-assets:informationsecurityevent,
      plays linked-incident:informationsecurityevent;
  
  entity informationsecurityincident, sub namedentity,
      owns incident-datetime,
      owns incident-category,
      owns severity,
      owns affected-cia @card(0..),
      owns incident-description,
      owns detection-method,
      owns response-actions @card(0..),
      owns containment-actions @card(0..),
      owns eradication-actions @card(0..),
      owns recovery-actions @card(0..),
      owns root-cause,
      owns lessons-learned @card(0..),
      owns evidence-collected @card(0..),
      owns notification-required,
      owns notifications-made @card(0..),
      owns closure-datetime,
      owns post-incident-review,
      plays linked-incident:informationsecurityincident,
      plays affected-assets:informationsecurityincident;
  

