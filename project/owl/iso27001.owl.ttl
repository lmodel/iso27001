<https://w3id.org/lmodel/iso27001/RiskLevel#critical> a owl:Class ;
    rdfs:label "critical" ;
    rdfs:subClassOf iso27001:RiskLevel ;
    skos:definition "Severe risk threatening organizational objectives; requires immediate executive action and resource allocation." .

<https://w3id.org/lmodel/iso27001/RiskLevel#high> a owl:Class ;
    rdfs:label "high" ;
    rdfs:subClassOf iso27001:RiskLevel ;
    skos:definition "Significant risk requiring priority treatment and escalation." .

<https://w3id.org/lmodel/iso27001/RiskLevel#low> a owl:Class ;
    rdfs:label "low" ;
    rdfs:subClassOf iso27001:RiskLevel ;
    skos:definition "Minor risk manageable through routine procedures." .

<https://w3id.org/lmodel/iso27001/RiskLevel#medium> a owl:Class ;
    rdfs:label "medium" ;
    rdfs:subClassOf iso27001:RiskLevel ;
    skos:definition "Moderate risk requiring management attention and planned controls." .

<https://w3id.org/lmodel/iso27001/RiskLevel#very_low> a owl:Class ;
    rdfs:label "very_low" ;
    rdfs:subClassOf iso27001:RiskLevel ;
    skos:definition "Negligible risk requiring no immediate action." .

<https://w3id.org/lmodel/iso27001/RiskTreatmentOption#accept> a owl:Class ;
    rdfs:label "accept" ;
    rdfs:subClassOf iso27001:RiskTreatmentOption ;
    skos:altLabel "retain" ;
    skos:definition "Accept the risk without further treatment, within risk appetite. Requires risk owner approval." .

<https://w3id.org/lmodel/iso27001/RiskTreatmentOption#avoid> a owl:Class ;
    rdfs:label "avoid" ;
    rdfs:subClassOf iso27001:RiskTreatmentOption ;
    skos:altLabel "terminate" ;
    skos:definition "Eliminate the risk by removing the activity or asset that creates it." .

<https://w3id.org/lmodel/iso27001/RiskTreatmentOption#modify> a owl:Class ;
    rdfs:label "modify" ;
    rdfs:subClassOf iso27001:RiskTreatmentOption ;
    skos:altLabel "mitigate",
        "reduce" ;
    skos:definition "Apply controls to change the risk level (reduce likelihood or impact)." .

<https://w3id.org/lmodel/iso27001/RiskTreatmentOption#share> a owl:Class ;
    rdfs:label "share" ;
    rdfs:subClassOf iso27001:RiskTreatmentOption ;
    skos:altLabel "transfer" ;
    skos:definition "Transfer or share risk with external parties (e.g., insurance, outsourcing)." .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#account_compromise> a owl:Class ;
    rdfs:label "account_compromise" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:definition "Unauthorized control of a legitimate user or service account." ;
    skos:relatedMatch attack:tactic_ta0006 .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#configuration_error> a owl:Class ;
    rdfs:label "configuration_error" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:definition "Misconfiguration leading to security exposure." .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#cryptographic_failure> a owl:Class ;
    rdfs:label "cryptographic_failure" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:definition "Weak, broken, or misused cryptography." .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#data_breach> a owl:Class ;
    rdfs:label "data_breach" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:definition "Confirmed disclosure of confidential or personal information." ;
    skos:relatedMatch attack:tactic_ta0010 .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#data_loss> a owl:Class ;
    rdfs:label "data_loss" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:definition "Loss of integrity or availability of information, including accidental deletion." .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#denial_of_service> a owl:Class ;
    rdfs:label "denial_of_service" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:closeMatch capec:capec_125 ;
    skos:definition "Disruption of availability through volumetric, protocol, or application attacks." ;
    skos:relatedMatch attack:tactic_ta0040 .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#insider_threat> a owl:Class ;
    rdfs:label "insider_threat" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:definition "Malicious or negligent action by an internal party." ;
    skos:relatedMatch attack:tactic_ta0004,
        stix:ThreatActor .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#malware> a owl:Class ;
    rdfs:label "malware" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:closeMatch stix:Malware ;
    skos:definition "Malicious software, including viruses, worms, trojans, and ransomware." ;
    skos:relatedMatch attack:tactic_ta0002 .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#other> a owl:Class ;
    rdfs:label "other" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:definition "Other incident type not covered by the listed categories." .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#phishing> a owl:Class ;
    rdfs:label "phishing" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:closeMatch capec:capec_98 ;
    skos:definition "Social-engineering attempt to obtain credentials or trigger malicious action." ;
    skos:relatedMatch attack:tactic_ta0001,
        stix:AttackPattern .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#physical_security> a owl:Class ;
    rdfs:label "physical_security" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:definition "Theft, loss, or damage of physical assets or unauthorized physical access." .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#policy_violation> a owl:Class ;
    rdfs:label "policy_violation" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:definition "Failure to comply with information security policies or procedures." .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#privilege_misuse> a owl:Class ;
    rdfs:label "privilege_misuse" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:definition "Authorized user exceeding or misusing their granted privileges." ;
    skos:relatedMatch attack:tactic_ta0004 .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#ransomware> a owl:Class ;
    rdfs:label "ransomware" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:definition "Malware encrypting or exfiltrating data for extortion." ;
    skos:relatedMatch attack:tactic_ta0040,
        stix:Malware .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#social_engineering> a owl:Class ;
    rdfs:label "social_engineering" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:definition "Manipulation of people to disclose information or perform unsafe actions." .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#supply_chain> a owl:Class ;
    rdfs:label "supply_chain" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:definition "Incident originating from a supplier, partner, or third-party component." ;
    skos:relatedMatch attack:technique_t1195 .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#unauthorized_access> a owl:Class ;
    rdfs:label "unauthorized_access" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:definition "Access to systems or data by a party without authorization." ;
    skos:relatedMatch attack:tactic_ta0001 .

<https://w3id.org/lmodel/iso27001/SecurityIncidentCategory#web_application_attack> a owl:Class ;
    rdfs:label "web_application_attack" ;
    rdfs:subClassOf iso27001:SecurityIncidentCategory ;
    skos:definition "Attack targeting a web application (e.g., injection, XSS, broken auth)." .

iso27001:SoAEntry a owl:Class ;
    rdfs:label "SoAEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:target_implementation_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso27001:ImplementationStatus ;
            owl:onProperty iso27001:implementation_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:implementation_evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso27001:Role ;
            owl:onProperty iso27001:responsible_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:exclusion_justification ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso27001:target_implementation_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:is_applicable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:implementation_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:control_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:implementation_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:exclusion_justification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:control_reference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty iso27001:is_applicable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:implementation_evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:target_implementation_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:exclusion_justification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:is_applicable ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso27001:SecurityControl ;
            owl:onProperty iso27001:control_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:inclusion_justification ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:inclusion_justification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:implementation_evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:responsible_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:responsible_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:inclusion_justification ] ;
    skos:closeMatch oscal:SspImplementedRequirement ;
    skos:definition "A single entry in the Statement of Applicability, documenting the applicability and implementation status of one control." ;
    skos:exactMatch iso42001:SoAEntry ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "Each Annex A control should have a corresponding SoA entry",
        "Exclusions require documented justification" .

iso27001:action_items a owl:DatatypeProperty ;
    rdfs:label "action_items" ;
    rdfs:range xsd:string ;
    skos:definition "Action items from the review." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:addressed_requirements a owl:DatatypeProperty ;
    rdfs:label "addressed_requirements" ;
    rdfs:range xsd:string ;
