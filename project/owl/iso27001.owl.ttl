            owl:onProperty iso27001:action_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:responsible_party ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:isms_changes_required ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:root_cause_addressed ],
        iso27001:NamedEntity ;
    skos:closeMatch oscal:PoamItem ;
    skos:definition "A corrective action per Clause 10.2 to address the root cause of a nonconformity and reduce the likelihood of recurrence." ;
    skos:exactMatch iso42001:CorrectiveAction ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "Reference: ISO/IEC 27001:2022 Clause 10.2. ISO/IEC standards text is copyright ISO - not reproduced here.",
