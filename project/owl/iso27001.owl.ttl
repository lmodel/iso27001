<https://w3id.org/lmodel/iso27001/DocumentType#guideline> a owl:Class ;
    rdfs:label "guideline" ;
    rdfs:subClassOf iso27001:DocumentType ;
    skos:definition "Recommended practices that support policies and procedures." .

<https://w3id.org/lmodel/iso27001/DocumentType#plan> a owl:Class ;
    rdfs:label "plan" ;
    rdfs:subClassOf iso27001:DocumentType ;
