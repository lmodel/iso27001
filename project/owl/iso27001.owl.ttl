            owl:minCardinality 0 ;
            owl:onProperty iso27001:risk_owner ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:risk_owner ],
        [ a owl:Restriction ;
