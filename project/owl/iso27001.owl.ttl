    skos:closeMatch cve:CveRecord,
        iso42001:AIRisk,
        kev_catalog:KevVulnerability,
        nvd:CveItem ;
    skos:definition "An identified information security risk that may affect information security properties within the ISMS scope." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "Links threat, vulnerability, and affected assets to risk ownership",
        "Reference: ISO/IEC 27001:2022 Clause 6.1.2. ISO/IEC standards text is copyright ISO - not reproduced here.",
        "Supports likelihood, impact, treatment, and residual risk tracking" ;
    skos:relatedMatch attack:AttackTechnique,
