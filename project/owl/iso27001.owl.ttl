            owl:minCardinality 0 ;
            owl:onProperty iso27001:risk_treatment_plans ],
        iso27001:NamedEntity ;
    skos:closeMatch iso42001:AIManagementSystem,
        oscal:SystemSecurityPlan ;
    skos:definition "Top-level container representing an organization's complete ISMS per ISO 27001. Aggregates all components required to support the full ISMS lifecycle." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "Aggregates ISMS processes and their relationships",
        "Includes explicit scope metadata and related governance artifacts",
        "Reference: ISO/IEC 27001:2022 Clause 4.4. ISO/IEC standards text is copyright ISO - not reproduced here.",
        "This is the root entity for any ISMS conformance dataset" ;
    skos:relatedMatch cis_controls:CISControlsDocument,
        iso29100:PrivacyFramework,
        nist_csf_v2:CSFDocument ;
    iso27001:iso27001_clause "4.4" ;
    iso27001:mandatory "true" .

xsd:duration a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

xsd:positiveInteger a rdfs:Datatype ;
    owl:equivalentClass xsd:integer .

<https://w3id.org/lmodel/iso27001/AnnexAControlId#a_5_1> a owl:Class ;
    rdfs:label "a_5_1" ;
    rdfs:subClassOf iso27001:AnnexAControlId ;
    skos:closeMatch cis_controls:safeguard_14_1,
        nist_csf_v2:subcategory_gv_pomg_01,
        nist_sp_800_53:control_pm_1 ;
    iso27001:annex_a_reference "A.5.1" ;
    iso27001:control_category "organizational" .

