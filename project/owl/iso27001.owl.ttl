            owl:maxCardinality 1 ;
            owl:onProperty iso27001:monitoring_program ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:top_management ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso27001:RiskAssessmentProcess ;
            owl:onProperty iso27001:risk_assessment_process ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
