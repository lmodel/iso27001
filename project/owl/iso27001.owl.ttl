        "Tracks actions intended to prevent recurrence of nonconformities" ;
    iso27001:iso27001_clause "10.2" .

iso27001:ImpactRating a owl:Class ;
    rdfs:label "ImpactRating" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso27001/ImpactRating#negligible> <https://w3id.org/lmodel/iso27001/ImpactRating#minor> <https://w3id.org/lmodel/iso27001/ImpactRating#moderate> <https://w3id.org/lmodel/iso27001/ImpactRating#major> <https://w3id.org/lmodel/iso27001/ImpactRating#severe> ) ;
    skos:definition "Qualitative impact scale for risk assessment." ;
    skos:exactMatch iso42001:ImpactRating ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    linkml:permissible_values <https://w3id.org/lmodel/iso27001/ImpactRating#major>,
        <https://w3id.org/lmodel/iso27001/ImpactRating#minor>,
        <https://w3id.org/lmodel/iso27001/ImpactRating#moderate>,
        <https://w3id.org/lmodel/iso27001/ImpactRating#negligible>,
        <https://w3id.org/lmodel/iso27001/ImpactRating#severe> .

iso27001:LikelihoodRating a owl:Class ;
    rdfs:label "LikelihoodRating" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso27001/LikelihoodRating#rare> <https://w3id.org/lmodel/iso27001/LikelihoodRating#unlikely> <https://w3id.org/lmodel/iso27001/LikelihoodRating#possible> <https://w3id.org/lmodel/iso27001/LikelihoodRating#likely> <https://w3id.org/lmodel/iso27001/LikelihoodRating#almost_certain> ) ;
    skos:definition "Qualitative likelihood scale for risk assessment." ;
    skos:exactMatch iso42001:LikelihoodRating ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
