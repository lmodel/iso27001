	skos:definition "One risk assessment carried out under the risk assessment process, and what it found." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	iso27001:iso27001_clause "8.2" .
iso27001:IsmsRiskAssessmentProcess a owl:Class ;
	rdfs:label "IsmsRiskAssessmentProcess" ;
	rdfs:subClassOf iso27001:IsmsDocumentControlMixin , iso27001:IsmsRecordMixin , _:c14n1028 , _:c14n1030 , _:c14n1090 , _:c14n18 , _:c14n190 , _:c14n231 , _:c14n24 , _:c14n254 , _:c14n404 , _:c14n409 , _:c14n5 , _:c14n517 , _:c14n598 , _:c14n628 , _:c14n650 , _:c14n659 , _:c14n676 , _:c14n708 , _:c14n806 , _:c14n819 , _:c14n836 , _:c14n982 , _:c14n995 ;
	skos:definition "The organization's process for assessing information security risks: its criteria for accepting risk and for assessing it, its scales and method, and when it runs." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	iso27001:iso27001_clause "6.1.2" .
iso27001:IsmsRiskLevel\#critical a owl:Class ;
	rdfs:label "critical" ;
	rdfs:subClassOf iso27001:IsmsRiskLevel ;
	skos:definition "Threatens the organization's objectives and needs action at once." .
iso27001:IsmsRiskLevel\#high a owl:Class ;
	rdfs:label "high" ;
	rdfs:subClassOf iso27001:IsmsRiskLevel ;
	skos:definition "Needs treatment first and escalation." .
iso27001:IsmsRiskLevel\#low a owl:Class ;
	rdfs:label "low" ;
	rdfs:subClassOf iso27001:IsmsRiskLevel ;
	skos:definition "Managed by routine procedures." .
iso27001:IsmsRiskLevel\#medium a owl:Class ;
	rdfs:label "medium" ;
	rdfs:subClassOf iso27001:IsmsRiskLevel ;
	skos:definition "Needs management's attention and planned controls." .
iso27001:IsmsRiskLevel\#very_low a owl:Class ;
	rdfs:label "very_low" ;
	rdfs:subClassOf iso27001:IsmsRiskLevel ;
	skos:definition "Small enough to need no action." .
iso27001:IsmsRiskLevel a owl:Class ;
	rdfs:label "IsmsRiskLevel" ;
	owl:unionOf _:c14n200 ;
	skos:definition "A five-point scale of risk level, for an organization that adopts it. ISO/IEC 27001 leaves the scale to the organization." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	linkml:permissible_values iso27001:IsmsRiskLevel\#critical , iso27001:IsmsRiskLevel\#high , iso27001:IsmsRiskLevel\#low , iso27001:IsmsRiskLevel\#medium , iso27001:IsmsRiskLevel\#very_low .
iso27001:IsmsRiskTreatmentOption\#avoid a owl:Class ;
	rdfs:label "avoid" ;
	rdfs:subClassOf iso27001:IsmsRiskTreatmentOption ;
	skos:altLabel "terminate" ;
	skos:definition "Remove the risk by stopping or changing what gives rise to it." .
iso27001:IsmsRiskTreatmentOption\#modify a owl:Class ;
	rdfs:label "modify" ;
	rdfs:subClassOf iso27001:IsmsRiskTreatmentOption ;
	skos:altLabel "mitigate" , "reduce" ;
	skos:definition "Change the risk with controls that lower its likelihood or its consequences." .
iso27001:IsmsRiskTreatmentOption\#retain a owl:Class ;
	rdfs:label "retain" ;
	rdfs:subClassOf iso27001:IsmsRiskTreatmentOption ;
	skos:altLabel "accept" ;
	skos:definition "Keep the risk as it is, with the risk owner's approval." .
iso27001:IsmsRiskTreatmentOption\#share a owl:Class ;
	rdfs:label "share" ;
	rdfs:subClassOf iso27001:IsmsRiskTreatmentOption ;
	skos:altLabel "transfer" ;
	skos:definition "Share the risk with another party, such as an insurer or a supplier." .
iso27001:IsmsRiskTreatmentOption a owl:Class ;
	rdfs:label "IsmsRiskTreatmentOption" ;
	owl:unionOf _:c14n726 ;
	skos:definition "The ways of treating a risk, by the names ISO/IEC 27005 gives them." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	linkml:permissible_values iso27001:IsmsRiskTreatmentOption\#avoid , iso27001:IsmsRiskTreatmentOption\#modify , iso27001:IsmsRiskTreatmentOption\#retain , iso27001:IsmsRiskTreatmentOption\#share .
iso27001:IsmsRiskTreatmentPlan a owl:Class ;
	rdfs:label "IsmsRiskTreatmentPlan" ;
	rdfs:subClassOf iso27001:IsmsDocumentControlMixin , iso27001:IsmsRecordMixin , _:c14n1010 , _:c14n1022 , _:c14n1048 , _:c14n122 , _:c14n131 , _:c14n151 , _:c14n159 , _:c14n273 , _:c14n277 , _:c14n301 , _:c14n304 , _:c14n327 , _:c14n329 , _:c14n345 , _:c14n390 , _:c14n40 , _:c14n414 , _:c14n421 , _:c14n429 , _:c14n561 , _:c14n618 , _:c14n763 , _:c14n769 , _:c14n8 , _:c14n808 , _:c14n810 , _:c14n848 , _:c14n909 , _:c14n953 ;
	skos:definition "A plan to treat one or more risks: the actions and controls, who carries them out and when, and the risk owner's approval of the plan and of the residual risk." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	skos:relatedMatch oscal:PlanOfActionAndMilestones ;
	iso27001:iso27001_clause "6.1.3" .
iso27001:IsmsRiskTreatmentProcess a owl:Class ;
	rdfs:label "IsmsRiskTreatmentProcess" ;
	rdfs:subClassOf iso27001:IsmsDocumentControlMixin , iso27001:IsmsRecordMixin , _:c14n1040 , _:c14n147 , _:c14n188 , _:c14n338 , _:c14n43 , _:c14n509 , _:c14n510 , _:c14n54 , _:c14n613 , _:c14n642 , _:c14n67 , _:c14n817 , _:c14n822 , _:c14n984 , _:c14n989 ;
	skos:definition "The organization's process for treating information security risks: how it chooses treatments and controls, checks them against Annex A, and produces the Statement of Applicability." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	iso27001:iso27001_clause "6.1.3" .
iso27001:IsmsRole a owl:Class ;
	rdfs:label "IsmsRole" ;
	rdfs:subClassOf iso27001:IsmsRecordMixin , _:c14n206 , _:c14n25 , _:c14n30 , _:c14n303 , _:c14n313 , _:c14n435 , _:c14n476 , _:c14n485 , _:c14n585 , _:c14n62 , _:c14n649 , _:c14n651 , _:c14n658 , _:c14n752 , _:c14n843 , _:c14n889 , _:c14n932 , _:c14n994 ;
	skos:closeMatch oscal:Role ;
	skos:definition "A role in the ISMS, with the responsibilities and authorities it carries and who holds it." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	iso27001:iso27001_clause "5.3" .
iso27001:IsmsSecurityEvent a owl:Class ;
	rdfs:label "IsmsSecurityEvent" ;
	rdfs:subClassOf iso27001:IsmsRecordMixin , _:c14n1018 , _:c14n334 , _:c14n352 , _:c14n403 , _:c14n408 , _:c14n434 , _:c14n448 , _:c14n611 , _:c14n63 , _:c14n730 , _:c14n783 , _:c14n792 , _:c14n805 , _:c14n89 ;
	skos:definition "An information security event someone reported, and the assessment of whether it is an incident. An event assessed as an incident is recorded as an IsmsSecurityIncident." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	iso27001:annex_a_control "5.25" .
iso27001:IsmsSecurityIncident a owl:Class ;
	rdfs:label "IsmsSecurityIncident" ;
	rdfs:subClassOf iso27001:IsmsSecurityEvent , _:c14n103 , _:c14n1052 , _:c14n1063 , _:c14n1073 , _:c14n134 , _:c14n154 , _:c14n224 , _:c14n256 , _:c14n271 , _:c14n288 , _:c14n341 , _:c14n368 , _:c14n383 , _:c14n386 , _:c14n388 , _:c14n411 , _:c14n444 , _:c14n483 , _:c14n49 , _:c14n511 , _:c14n525 , _:c14n56 , _:c14n571 , _:c14n615 , _:c14n616 , _:c14n647 , _:c14n670 , _:c14n678 , _:c14n681 , _:c14n725 , _:c14n745 , _:c14n761 , _:c14n764 , _:c14n765 , _:c14n798 , _:c14n818 , _:c14n863 ;
	skos:definition "An information security event assessed as an incident: its category and severity, how it was detected, contained, eradicated and recovered from, the evidence collected, who was told, and what was learned." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	iso27001:annex_a_control "5.26" .
iso27001:IsmsSecurityProperty\#availability a owl:Class ;
	rdfs:label "availability" ;
	rdfs:subClassOf iso27001:IsmsSecurityProperty ;
	skos:definition "Those allowed to use the information can use it when they need it." .
iso27001:IsmsSecurityProperty\#confidentiality a owl:Class ;
	rdfs:label "confidentiality" ;
	rdfs:subClassOf iso27001:IsmsSecurityProperty ;
	skos:definition "Only those allowed to see the information can see it." .
iso27001:IsmsSecurityProperty\#integrity a owl:Class ;
	rdfs:label "integrity" ;
	rdfs:subClassOf iso27001:IsmsSecurityProperty ;
	skos:definition "The information is accurate and complete." .
iso27001:IsmsSecurityProperty a owl:Class ;
	rdfs:label "IsmsSecurityProperty" ;
	owl:unionOf _:c14n537 ;
	skos:definition "The three properties of information that information security preserves, as ISO/IEC 27000 names them." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	linkml:permissible_values iso27001:IsmsSecurityProperty\#availability , iso27001:IsmsSecurityProperty\#confidentiality , iso27001:IsmsSecurityProperty\#integrity ;
	iso27001:iso27001_clause "6.1.2" .
iso27001:IsmsStatementOfApplicability a owl:Class ;
	rdfs:label "IsmsStatementOfApplicability" ;
	rdfs:subClassOf iso27001:IsmsDocumentControlMixin , iso27001:IsmsRecordMixin , _:c14n291 , _:c14n499 ;
	skos:definition "The Statement of Applicability: each control the organization needs, with why it is included and whether it is in place, and each Annex A control it leaves out, with why." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	skos:relatedMatch oscal:SspControlImplementation ;
	iso27001:iso27001_clause "6.1.3" .
iso27001:IsmsTopicSpecificPolicy a owl:Class ;
	rdfs:label "IsmsTopicSpecificPolicy" ;
	rdfs:subClassOf iso27001:IsmsDocumentControlMixin , iso27001:IsmsRecordMixin , _:c14n1079 , _:c14n284 , _:c14n4 , _:c14n523 , _:c14n533 , _:c14n596 , _:c14n683 , _:c14n760 , _:c14n802 , _:c14n877 , _:c14n922 ;
	skos:definition "A policy on one topic of information security, such as access control or backup, that supports the information security policy." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	iso27001:annex_a_control "5.1" .
iso27001:action_completion_date a owl:DatatypeProperty ;
	rdfs:label "action_completion_date" ;
	skos:definition "When the action was complete." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:action_effective a owl:DatatypeProperty ;
	rdfs:label "action_effective" ;
	skos:definition "Whether the review found the action effective." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:action_effectiveness_criteria a owl:DatatypeProperty ;
	rdfs:label "action_effectiveness_criteria" ;
	skos:definition "How the action's effect will be judged." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:action_effectiveness_review_date a owl:DatatypeProperty ;
	rdfs:label "action_effectiveness_review_date" ;
	skos:definition "When the action's effect was reviewed." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:action_isms_changes a owl:DatatypeProperty ;
	rdfs:label "action_isms_changes" ;
	skos:definition "The changes to the ISMS the action needs." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:action_nonconformities a owl:ObjectProperty ;
	rdfs:label "action_nonconformities" ;
	skos:definition "The nonconformities the action addresses." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:action_resources a owl:DatatypeProperty ;
	rdfs:label "action_resources" ;
	skos:definition "The resources the action needs." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:action_root_cause a owl:DatatypeProperty ;
	rdfs:label "action_root_cause" ;
	skos:definition "The cause the action removes." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:action_status a owl:DatatypeProperty ;
	rdfs:label "action_status" ;
	skos:definition "Where the action stands, in the organization's own terms." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:action_target_date a owl:DatatypeProperty ;
	rdfs:label "action_target_date" ;
	skos:definition "When the action is to be complete." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:affected_assets a owl:ObjectProperty ;
	rdfs:label "affected_assets" ;
	rdfs:range iso27001:IsmsAsset ;
	skos:definition "The assets the risk, event or incident affects." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:affected_security_properties a owl:ObjectProperty ;
	rdfs:label "affected_security_properties" ;
	rdfs:range iso27001:IsmsSecurityProperty ;
	skos:definition "Which of confidentiality, integrity and availability the risk or incident threatens." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:assessment_assessor a owl:DatatypeProperty ;
	rdfs:label "assessment_assessor" ;
	skos:definition "Who carried out the assessment." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:assessment_date a owl:DatatypeProperty ;
	rdfs:label "assessment_date" ;
	skos:definition "When the assessment was carried out." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:assessment_method_used a owl:DatatypeProperty ;
	rdfs:label "assessment_method_used" ;
	skos:definition "The method this assessment applied." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:assessment_next_date a owl:DatatypeProperty ;
	rdfs:label "assessment_next_date" ;
	skos:definition "When the next assessment is planned." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:assessment_recommendations a owl:DatatypeProperty ;
	rdfs:label "assessment_recommendations" ;
	skos:definition "What the assessment recommends." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:assessment_risks a owl:ObjectProperty ;
	rdfs:label "assessment_risks" ;
	skos:definition "The risks the assessment identified." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:assessment_scope a owl:DatatypeProperty ;
	rdfs:label "assessment_scope" ;
	skos:definition "What the assessment covered." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:assessment_summary a owl:DatatypeProperty ;
	rdfs:label "assessment_summary" ;
	skos:definition "A summary of what the assessment found." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> .
iso27001:asset_category a owl:DatatypeProperty ;
	rdfs:label "asset_category" ;
	skos:definition "What kind of asset it is, such as information, software, hardware or a service." ;
