    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "Subset of requirements that the ISMS commits to address" ;
    iso27001:iso27001_clause "4.2" .

iso27001:affected_cia a owl:ObjectProperty ;
