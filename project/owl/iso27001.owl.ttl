        <https://w3id.org/lmodel/iso27001/LikelihoodRating#likely>,
        <https://w3id.org/lmodel/iso27001/LikelihoodRating#possible>,
        <https://w3id.org/lmodel/iso27001/LikelihoodRating#rare>,
        <https://w3id.org/lmodel/iso27001/LikelihoodRating#unlikely> .

xsd:unsignedShort a rdfs:Datatype ;
    owl:equivalentClass xsd:integer .

iso27001:AuditType a owl:Class ;
    rdfs:label "AuditType" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso27001/AuditType#internal> <https://w3id.org/lmodel/iso27001/AuditType#external_second_party> <https://w3id.org/lmodel/iso27001/AuditType#external_third_party> <https://w3id.org/lmodel/iso27001/AuditType#surveillance> <https://w3id.org/lmodel/iso27001/AuditType#recertification> <https://w3id.org/lmodel/iso27001/AuditType#combined> ) ;
    skos:definition "Classification of audits referenced by ISO/IEC 27001:2022 Clause 9.2 and ISO/IEC 17021-1 (audit programmes)." ;
    skos:exactMatch iso42001:AuditType ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    linkml:permissible_values <https://w3id.org/lmodel/iso27001/AuditType#combined>,
        <https://w3id.org/lmodel/iso27001/AuditType#external_second_party>,
        <https://w3id.org/lmodel/iso27001/AuditType#external_third_party>,
        <https://w3id.org/lmodel/iso27001/AuditType#internal>,
        <https://w3id.org/lmodel/iso27001/AuditType#recertification>,
        <https://w3id.org/lmodel/iso27001/AuditType#surveillance> ;
    iso27001:iso27001_clause "9.2" .

