iso27001:required_competencies a owl:DatatypeProperty ;
    rdfs:label "required_competencies" ;
    rdfs:range xsd:string ;
    skos:definition "Competencies required for the role." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:requirements a owl:DatatypeProperty ;
    rdfs:label "requirements" ;
    rdfs:range xsd:string ;
    skos:definition "Requirements of the interested party." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "May include legal, regulatory, and contractual requirements" .

iso27001:resources a owl:ObjectProperty ;
    rdfs:label "resources" ;
    rdfs:range iso27001:Resource ;
    skos:definition "Resources provided for the ISMS." ;
    skos:exactMatch iso42001:resources ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:response_actions a owl:DatatypeProperty ;
    rdfs:label "response_actions" ;
    rdfs:range xsd:string ;
    skos:definition "Actions taken in response." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:responsibilities a owl:DatatypeProperty ;
    rdfs:label "responsibilities" ;
    rdfs:range xsd:string ;
    skos:definition "Responsibilities assigned to the role." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:responsible_parties a owl:DatatypeProperty ;
    rdfs:label "responsible_parties" ;
    rdfs:range xsd:string ;
    skos:definition "Parties responsible for implementation." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:responsible_roles a owl:ObjectProperty ;
    rdfs:label "responsible_roles" ;
    rdfs:range iso27001:Role ;
    skos:definition "Roles responsible for the procedure." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:risk_assessments a owl:ObjectProperty ;
    rdfs:label "risk_assessments" ;
    rdfs:range iso27001:RiskAssessment ;
    skos:closeMatch iso42001:ai_risk_assessments ;
    skos:definition "Risk assessment instances." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:risk_treatment_plans a owl:ObjectProperty ;
    rdfs:label "risk_treatment_plans" ;
    rdfs:range iso27001:RiskTreatmentPlan ;
    skos:closeMatch iso42001:ai_risk_treatment_plans ;
    skos:definition "Risk treatment plans." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:risks_addressed a owl:ObjectProperty ;
    rdfs:label "risks_addressed" ;
    rdfs:range iso27001:Risk ;
    skos:definition "Risks addressed by this plan." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:risks_and_opportunities_actions a owl:DatatypeProperty ;
    rdfs:label "risks_and_opportunities_actions" ;
    rdfs:range xsd:string ;
    skos:definition "Actions to address risks and opportunities determined per Clause 6.1.1, including how they are integrated into ISMS processes and how their effectiveness is evaluated." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "6.1.1" .

iso27001:risks_identified a owl:ObjectProperty ;
    rdfs:label "risks_identified" ;
    rdfs:range iso27001:Risk ;
    skos:definition "Risks identified in this assessment." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:roles a owl:ObjectProperty ;
    rdfs:label "roles" ;
    rdfs:range iso27001:Role ;
    skos:closeMatch iso42001:ai_roles ;
    skos:definition "Information security roles defined in the ISMS." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:scope_boundaries a owl:DatatypeProperty ;
    rdfs:label "scope_boundaries" ;
    rdfs:range xsd:string ;
    skos:definition "Defined boundaries of the ISMS scope." ;
    skos:exactMatch iso42001:scope_boundaries ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:scope_exclusions a owl:DatatypeProperty ;
    rdfs:label "scope_exclusions" ;
    rdfs:range xsd:string ;
    skos:definition "Any exclusions from scope with justification." ;
    skos:exactMatch iso42001:scope_exclusions ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:soa_entries a owl:ObjectProperty ;
    rdfs:label "soa_entries" ;
    rdfs:range iso27001:SoAEntry ;
    skos:definition "Individual control entries in the SoA." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:subsidiaries a owl:DatatypeProperty ;
    rdfs:label "subsidiaries" ;
    rdfs:range xsd:string ;
    skos:definition "Subsidiary organizations if applicable." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:trading_names a owl:DatatypeProperty ;
    rdfs:label "trading_names" ;
    rdfs:range xsd:string ;
    skos:definition "Names under which the organization conducts business." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:training_records a owl:DatatypeProperty ;
    rdfs:label "training_records" ;
    rdfs:range xsd:string ;
    skos:definition "Training completed." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:treatment_actions a owl:DatatypeProperty ;
    rdfs:label "treatment_actions" ;
    rdfs:range xsd:string ;
    skos:definition "Actions to be taken for treatment." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:trigger_events a owl:DatatypeProperty ;
    rdfs:label "trigger_events" ;
    rdfs:range xsd:string ;
