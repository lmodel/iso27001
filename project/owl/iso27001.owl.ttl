        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:treatment_actions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:approved_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:plan_scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:responsible_parties ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:resources_required ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:risk_owner_approval ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:resources_required ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso27001:Risk ;
            owl:onProperty iso27001:risks_addressed ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:completion_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:resources_required ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:plan_scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:residual_risk_acceptance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:plan_scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso27001:SecurityControl ;
            owl:onProperty iso27001:controls_to_implement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso27001:approved_date ],
        iso27001:DocumentedInformation ;
    skos:closeMatch iso42001:AIRiskTreatmentPlan,
        oscal:PlanOfActionAndMilestones ;
    skos:definition "A risk treatment plan documenting planned actions to address identified risks through selected controls." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "Captures treatment execution plans with approval and acceptance metadata",
        "Reference: ISO/IEC 27001:2022 Clause 6.1.3. ISO/IEC standards text is copyright ISO - not reproduced here.",
        "Supports implementation status and completion tracking" ;
    iso27001:iso27001_clause "6.1.3" .

iso27001:AuditFindingType a owl:Class ;
    rdfs:label "AuditFindingType" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso27001/AuditFindingType#major_nonconformity> <https://w3id.org/lmodel/iso27001/AuditFindingType#minor_nonconformity> <https://w3id.org/lmodel/iso27001/AuditFindingType#observation> <https://w3id.org/lmodel/iso27001/AuditFindingType#positive_finding> ) ;
    skos:definition "Classification of internal audit findings." ;
    skos:exactMatch iso42001:AuditFindingType ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    linkml:permissible_values <https://w3id.org/lmodel/iso27001/AuditFindingType#major_nonconformity>,
        <https://w3id.org/lmodel/iso27001/AuditFindingType#minor_nonconformity>,
        <https://w3id.org/lmodel/iso27001/AuditFindingType#observation>,
        <https://w3id.org/lmodel/iso27001/AuditFindingType#positive_finding> .

iso27001:ControlCategory a owl:Class ;
    rdfs:label "ControlCategory" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso27001/ControlCategory#organizational> <https://w3id.org/lmodel/iso27001/ControlCategory#people> <https://w3id.org/lmodel/iso27001/ControlCategory#physical> <https://w3id.org/lmodel/iso27001/ControlCategory#technological> ) ;
    skos:definition "The four control domains defined in ISO/IEC 27001:2022 Annex A, corresponding to Clauses 5-8 of ISO/IEC 27002:2022." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    linkml:permissible_values <https://w3id.org/lmodel/iso27001/ControlCategory#organizational>,
        <https://w3id.org/lmodel/iso27001/ControlCategory#people>,
        <https://w3id.org/lmodel/iso27001/ControlCategory#physical>,
        <https://w3id.org/lmodel/iso27001/ControlCategory#technological> ;
    iso27001:iso27002_mapping "Clauses 5-8" .

iso27001:RiskTreatmentOption a owl:Class ;
    rdfs:label "RiskTreatmentOption" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso27001/RiskTreatmentOption#modify> <https://w3id.org/lmodel/iso27001/RiskTreatmentOption#accept> <https://w3id.org/lmodel/iso27001/RiskTreatmentOption#avoid> <https://w3id.org/lmodel/iso27001/RiskTreatmentOption#share> ) ;
    skos:definition "Standard risk treatment options per ISO 31000 and ISO 27005." ;
    skos:exactMatch iso42001:RiskTreatmentOption ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    linkml:permissible_values <https://w3id.org/lmodel/iso27001/RiskTreatmentOption#accept>,
        <https://w3id.org/lmodel/iso27001/RiskTreatmentOption#avoid>,
        <https://w3id.org/lmodel/iso27001/RiskTreatmentOption#modify>,
        <https://w3id.org/lmodel/iso27001/RiskTreatmentOption#share> ;
    iso27001:iso31000_reference "Clause 6.5" .

iso27001:actual_completion_date a owl:DatatypeProperty ;
    rdfs:label "actual_completion_date" ;
    rdfs:range xsd:date ;
    skos:definition "Actual date the action was completed." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:affected_assets a owl:ObjectProperty ;
    rdfs:label "affected_assets" ;
    rdfs:range iso27001:Asset ;
    skos:closeMatch iso42001:affected_ai_systems ;
    skos:definition "Assets affected by this risk or incident." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:relatedMatch ocsf:Device .

iso27001:approved_by a owl:DatatypeProperty ;
    rdfs:label "approved_by" ;
    rdfs:range xsd:string ;
    skos:definition "Person who approved the document." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "Per 7.5.2 c) review and approval" .

iso27001:approved_date a owl:DatatypeProperty ;
    rdfs:label "approved_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date when the document was approved." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:classification a owl:DatatypeProperty ;
    rdfs:label "classification" ;
    rdfs:range xsd:string ;
    skos:definition "Information classification level." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "Per A.5.12, classification based on confidentiality, integrity, availability" .

iso27001:closure_date a owl:DatatypeProperty ;
    rdfs:label "closure_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date the finding was closed." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:control_reference a owl:ObjectProperty ;
    rdfs:label "control_reference" ;
    rdfs:range iso27001:SecurityControl ;
    skos:definition "Reference to the control (e.g., A.5.1)." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:current_value a owl:DatatypeProperty ;
    rdfs:label "current_value" ;
    rdfs:range xsd:string ;
    skos:definition "Current measured value." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:frequency a owl:DatatypeProperty ;
    rdfs:label "frequency" ;
    rdfs:range xsd:string ;
    skos:definition "Frequency of the activity." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:measurement_frequency a owl:DatatypeProperty ;
    rdfs:label "measurement_frequency" ;
    rdfs:range xsd:string ;
    skos:definition "How often measurement is performed." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:measurement_method a owl:DatatypeProperty ;
    rdfs:label "measurement_method" ;
    rdfs:range xsd:string ;
    skos:definition "Method used to measure the metric." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:related_controls a owl:ObjectProperty ;
    rdfs:label "related_controls" ;
    rdfs:range iso27001:SecurityControl ;
    skos:definition "Other controls related to this one." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:resources_required a owl:DatatypeProperty ;
    rdfs:label "resources_required" ;
    rdfs:range xsd:string ;
    skos:definition "Resources required for implementation." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:responsible_role a owl:ObjectProperty ;
    rdfs:label "responsible_role" ;
    rdfs:range iso27001:Role ;
    skos:definition "Role responsible for the objective or control." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:review_date a owl:DatatypeProperty ;
    rdfs:label "review_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date when the document is due for review." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:root_cause a owl:DatatypeProperty ;
    rdfs:label "root_cause" ;
    rdfs:range xsd:string ;
    skos:definition "Root cause of the nonconformity." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "10.2 b) 2)" .

iso27001:target_audience a owl:DatatypeProperty ;
    rdfs:label "target_audience" ;
    rdfs:range xsd:string ;
    skos:definition "Intended audience for the policy or document." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:target_date a owl:DatatypeProperty ;
    rdfs:label "target_date" ;
    rdfs:range xsd:date ;
    skos:definition "Target date for achieving the objective." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:CIAProperty a owl:Class ;
    rdfs:label "CIAProperty" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso27001/CIAProperty#confidentiality> <https://w3id.org/lmodel/iso27001/CIAProperty#integrity> <https://w3id.org/lmodel/iso27001/CIAProperty#availability> ) ;
    skos:definition "Information security properties whose loss is considered when identifying risks per ISO/IEC 27001:2022 Clause 6.1.2 c) 1)." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    linkml:permissible_values <https://w3id.org/lmodel/iso27001/CIAProperty#availability>,
        <https://w3id.org/lmodel/iso27001/CIAProperty#confidentiality>,
        <https://w3id.org/lmodel/iso27001/CIAProperty#integrity> ;
    iso27001:iso27001_clause "6.1.2 c) 1)" .

iso27001:CorrectiveAction a owl:Class ;
    rdfs:label "CorrectiveAction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
