	rdfs:label "IsmsNonconformity" ;
	rdfs:subClassOf iso27001:IsmsRecordMixin , _:c14n1085 , _:c14n12 , _:c14n128 , _:c14n149 , _:c14n187 , _:c14n189 , _:c14n252 , _:c14n275 , _:c14n297 , _:c14n309 , _:c14n346 , _:c14n380 , _:c14n468 , _:c14n502 , _:c14n51 , _:c14n527 , _:c14n547 , _:c14n577 , _:c14n582 , _:c14n589 , _:c14n679 , _:c14n692 , _:c14n734 , _:c14n756 , _:c14n780 , _:c14n833 , _:c14n868 , _:c14n870 , _:c14n926 , _:c14n938 , _:c14n991 , _:c14n999 ;
	skos:definition "A nonconformity: a requirement not met, how it was found and contained, its consequences and cause, and how it was closed." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	iso27001:iso27001_clause "10.2" .
iso27001:IsmsObjective a owl:Class ;
	rdfs:label "IsmsObjective" ;
	rdfs:subClassOf iso27001:IsmsRecordMixin , _:c14n1001 , _:c14n101 , _:c14n1011 , _:c14n1091 , _:c14n120 , _:c14n146 , _:c14n168 , _:c14n173 , _:c14n184 , _:c14n234 , _:c14n244 , _:c14n259 , _:c14n299 , _:c14n316 , _:c14n322 , _:c14n323 , _:c14n324 , _:c14n343 , _:c14n392 , _:c14n438 , _:c14n498 , _:c14n531 , _:c14n590 , _:c14n606 , _:c14n621 , _:c14n631 , _:c14n634 , _:c14n691 , _:c14n72 , _:c14n733 , _:c14n82 , _:c14n866 , _:c14n895 , _:c14n903 , _:c14n945 , _:c14n959 , _:c14n968 ;
	skos:definition "An information security objective: a measurable result the organization aims for, with how it plans to reach it and how it measures progress." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	iso27001:iso27001_clause "6.2" .
iso27001:IsmsOperationalProcedure a owl:Class ;
	rdfs:label "IsmsOperationalProcedure" ;
	rdfs:subClassOf iso27001:IsmsDocumentControlMixin , iso27001:IsmsRecordMixin , _:c14n1042 , _:c14n1075 , _:c14n195 , _:c14n226 , _:c14n282 , _:c14n337 , _:c14n381 , _:c14n430 , _:c14n57 , _:c14n572 , _:c14n655 , _:c14n71 , _:c14n750 , _:c14n856 , _:c14n99 ;
	skos:definition "A procedure by which the organization plans and controls the processes that meet its information security requirements." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	iso27001:iso27001_clause "8.1" .
iso27001:IsmsOrganization a owl:Class ;
	rdfs:label "IsmsOrganization" ;
	rdfs:subClassOf iso27001:IsmsRecordMixin , _:c14n10 , _:c14n1023 , _:c14n113 , _:c14n166 , _:c14n217 , _:c14n255 , _:c14n278 , _:c14n293 , _:c14n375 , _:c14n38 , _:c14n395 , _:c14n417 , _:c14n452 , _:c14n512 , _:c14n513 , _:c14n532 , _:c14n544 , _:c14n581 , _:c14n604 , _:c14n629 , _:c14n648 , _:c14n727 , _:c14n741 , _:c14n785 , _:c14n80 , _:c14n829 , _:c14n861 , _:c14n894 , _:c14n935 ;
	skos:broadMatch oscal:Party ;
	skos:closeMatch spdx_core:Organization ;
	skos:definition "The organization that runs the ISMS, with what it needs to know about itself to understand its context." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	iso27001:iso27001_clause "4.1" .
iso27001:IsmsPolicy a owl:Class ;
	rdfs:label "IsmsPolicy" ;
	rdfs:subClassOf iso27001:IsmsDocumentControlMixin , iso27001:IsmsRecordMixin , _:c14n1004 , _:c14n1036 , _:c14n1058 , _:c14n118 , _:c14n205 , _:c14n372 , _:c14n463 , _:c14n529 , _:c14n599 , _:c14n600 , _:c14n849 , _:c14n858 , _:c14n885 , _:c14n892 , _:c14n90 , _:c14n914 , _:c14n940 , _:c14n966 , _:c14n972 ;
	skos:definition "The information security policy that top management sets: the organization's commitment and the frame for its information security objectives." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	iso27001:iso27001_clause "5.2" .
iso27001:IsmsRecordMixin a owl:Class ;
	rdfs:label "IsmsRecordMixin" ;
	rdfs:subClassOf _:c14n1032 , _:c14n123 , _:c14n534 , _:c14n584 , _:c14n587 , _:c14n592 , _:c14n732 , _:c14n901 , _:c14n987 ;
	skos:definition "What every record of the ISMS has, so that other records can refer to it: an identifier, a title and a description." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	skos:note "It is a mixin, not a base class, so that the adapt copy can re-root some record classes on LOKF's Concept and leave the others as they are: lokf adapt replaces isms_id with LOKF's id, and a class that declares id itself must descend from Concept." .
iso27001:IsmsResource a owl:Class ;
	rdfs:label "IsmsResource" ;
	rdfs:subClassOf iso27001:IsmsRecordMixin , _:c14n1016 , _:c14n112 , _:c14n209 , _:c14n214 , _:c14n274 , _:c14n306 , _:c14n365 , _:c14n366 , _:c14n405 , _:c14n680 , _:c14n74 , _:c14n781 , _:c14n784 , _:c14n809 , _:c14n845 , _:c14n878 , _:c14n884 , _:c14n913 ;
	skos:definition "A resource provided for the ISMS, such as people, time, tools or budget." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	iso27001:iso27001_clause "7.1" .
iso27001:IsmsRisk a owl:Class ;
	rdfs:label "IsmsRisk" ;
	rdfs:subClassOf iso27001:IsmsRecordMixin , _:c14n0 , _:c14n1003 , _:c14n1053 , _:c14n1054 , _:c14n1080 , _:c14n143 , _:c14n161 , _:c14n228 , _:c14n26 , _:c14n286 , _:c14n340 , _:c14n362 , _:c14n398 , _:c14n401 , _:c14n431 , _:c14n481 , _:c14n491 , _:c14n494 , _:c14n495 , _:c14n530 , _:c14n540 , _:c14n560 , _:c14n594 , _:c14n620 , _:c14n696 , _:c14n735 , _:c14n779 , _:c14n85 , _:c14n874 , _:c14n891 , _:c14n902 , _:c14n937 , _:c14n943 , _:c14n944 , _:c14n958 , _:c14n996 ;
	skos:definition "An information security risk in the risk register: where it comes from, what it threatens, who owns it, how it is rated before and after controls, and how it is treated." ;
	skos:inScheme <https://w3id.org/lmodel/iso27001> ;
	iso27001:iso27001_clause "6.1.2" .
iso27001:IsmsRiskAssessment a owl:Class ;
	rdfs:label "IsmsRiskAssessment" ;
