        [ owl:unionOf ( iso27001:Asset iso27001:AuditFinding iso27001:CorrectiveAction iso27001:DocumentedInformation iso27001:ImprovementOpportunity iso27001:InformationSecurityEvent iso27001:InformationSecurityIncident iso27001:InformationSecurityManagementSystem iso27001:InformationSecurityObjective iso27001:InterestedParty iso27001:Nonconformity iso27001:Organization iso27001:Resource iso27001:Risk iso27001:Role iso27001:SecurityControl ) ],
