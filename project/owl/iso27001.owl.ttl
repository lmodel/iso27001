    rdfs:range xsd:string ;
    skos:definition "Subject of the communication." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:summary_findings a owl:DatatypeProperty ;
    rdfs:label "summary_findings" ;
    rdfs:range xsd:string ;
    skos:definition "Summary of assessment findings." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:target_completion_date a owl:DatatypeProperty ;
    rdfs:label "target_completion_date" ;
    rdfs:range xsd:date ;
    skos:definition "Target date for completing the action." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:target_implementation_date a owl:DatatypeProperty ;
    rdfs:label "target_implementation_date" ;
    rdfs:range xsd:date ;
    skos:definition "Target date for implementing the control." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:target_threshold a owl:DatatypeProperty ;
    rdfs:label "target_threshold" ;
    rdfs:range xsd:string ;
    skos:definition "Target threshold value." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:target_value a owl:DatatypeProperty ;
    rdfs:label "target_value" ;
    rdfs:range xsd:string ;
    skos:definition "Target value for the objective metric." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:threat_description a owl:DatatypeProperty ;
    rdfs:label "threat_description" ;
    rdfs:range xsd:string ;
    skos:definition "Description of the threat exploiting the vulnerability." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:top_management a owl:DatatypeProperty ;
    rdfs:label "top_management" ;
    rdfs:range xsd:string ;
    skos:definition "The person or group of people who direct and control the organization at the highest level, accountable for the ISMS per Clause 5.1." ;
    skos:exactMatch iso42001:top_management ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "5.1" .

iso27001:topic_area a owl:DatatypeProperty ;
    rdfs:label "topic_area" ;
    rdfs:range xsd:string ;
    skos:definition "The specific topic addressed by the policy." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:total_controls a owl:DatatypeProperty ;
    rdfs:label "total_controls" ;
    rdfs:range xsd:unsignedShort ;
    skos:definition "Total number of controls in scope." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:treatment_options_guidance a owl:DatatypeProperty ;
    rdfs:label "treatment_options_guidance" ;
    rdfs:range xsd:string ;
    skos:definition "Guidance on selecting treatment options." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:treatment_priority a owl:DatatypeProperty ;
    rdfs:label "treatment_priority" ;
    rdfs:range xsd:string ;
    skos:definition "Priority for treating this risk." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:trend a owl:DatatypeProperty ;
    rdfs:label "trend" ;
    rdfs:range xsd:string ;
    skos:definition "Current trend direction." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:range xsd:string ;
    skos:definition "Version identifier for the entity." ;
    skos:exactMatch iso42001:version ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "Supports document control requirements per 7.5.3 e)" .

iso27001:vulnerability_description a owl:DatatypeProperty ;
    rdfs:label "vulnerability_description" ;
    rdfs:range xsd:string ;
    skos:closeMatch cve:description,
        kev_catalog:shortDescription ;
    skos:definition "Description of the vulnerability that could be exploited." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:relatedMatch cwe:Weakness,
        stix:Vulnerability .

iso27001:applicable_controls a owl:ObjectProperty ;
    rdfs:label "applicable_controls" ;
    rdfs:range iso27001:SecurityControl ;
    skos:definition "Controls related to this policy." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:related_risks a owl:ObjectProperty ;
    rdfs:label "related_risks" ;
    rdfs:range iso27001:Risk ;
    skos:definition "Associated risks." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:Asset a owl:Class ;
    rdfs:label "Asset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:asset_owner ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:asset_owner ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:criticality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:classification ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:asset_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:asset_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:asset_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:asset_custodian ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:related_risks ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso27001:SecurityControl ;
            owl:onProperty iso27001:applicable_controls ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:location ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:applicable_controls ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:asset_owner ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:location ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:asset_custodian ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:classification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:criticality ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:classification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:location ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:asset_custodian ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:criticality ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso27001:Risk ;
            owl:onProperty iso27001:related_risks ],
        iso27001:NamedEntity ;
    skos:broadMatch iso42001:ComputingResource,
        iso42001:DataResource,
        iso42001:HumanResource,
        iso42001:ToolingResource ;
    skos:closeMatch ocsf:Device,
        oscal:SspInventoryItem,
        spdx:Package ;
    skos:definition "An information asset or associated asset requiring protection, per Annex A control 5.9." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "Reference: ISO/IEC 27001:2022 Annex A control 5.9; ISO/IEC 27002:2022 Clause 5.9. ISO/IEC standards text is copyright ISO - not reproduced here.",
        "Supports asset inventory, ownership, classification, and related controls" ;
    skos:relatedMatch iso29100:PII,
        iso42001:AISystem,
        nvd:CpeMatch,
        slsa:ResourceDescriptor,
        stix:Infrastructure ;
    iso27001:annex_a_control "5.9" .

iso27001:InformationSecurityPolicy a owl:Class ;
    rdfs:label "InformationSecurityPolicy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso27001:next_policy_review_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:last_policy_review_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso27001:RelatedManagementSystem ;
            owl:onProperty iso27001:integrated_management_systems ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:commitment_statements ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso27001:last_policy_review_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:commitment_statements ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso27001:communication_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:applicability_statement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:next_policy_review_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:policy_statement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:next_policy_review_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:policy_objectives_framework ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso27001:TopicSpecificPolicy ;
            owl:onProperty iso27001:related_topic_policies ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:policy_objectives_framework ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:communication_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:applicability_statement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:integrated_management_systems ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:policy_statement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:acknowledgment_required ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:policy_statement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:applicability_statement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:last_policy_review_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:related_topic_policies ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso27001:communication_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso27001:policy_objectives_framework ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty iso27001:acknowledgment_required ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso27001:acknowledgment_required ],
        iso27001:DocumentedInformation ;
    skos:closeMatch iso42001:AIPolicy ;
    skos:definition "The information security policy established by top management per Clause 5.2. Provides framework for setting objectives and demonstrates commitment." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "Captures policy intent and governance commitments",
        "Reference: ISO/IEC 27001:2022 Clause 5.2. ISO/IEC standards text is copyright ISO - not reproduced here.",
        "Supports communication and acknowledgement tracking" ;
    iso27001:iso27001_clause "5.2" ;
    iso27001:mandatory "true" .

