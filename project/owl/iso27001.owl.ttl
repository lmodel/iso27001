    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:audit_type a owl:ObjectProperty ;
    rdfs:label "audit_type" ;
    rdfs:range iso27001:AuditType ;
    skos:definition "Type of audit per ISO/IEC 27001:2022 Clause 9.2 and ISO/IEC 17021-1." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "9.2" .

iso27001:auditee_response a owl:DatatypeProperty ;
    rdfs:label "auditee_response" ;
    rdfs:range xsd:string ;
    skos:definition "Response from the auditee." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:auditor_qualifications a owl:DatatypeProperty ;
    rdfs:label "auditor_qualifications" ;
    rdfs:range xsd:string ;
    skos:definition "Required qualifications for auditors." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:author a owl:DatatypeProperty ;
    rdfs:label "author" ;
    rdfs:range xsd:string ;
    skos:definition "Person who created the document." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:availability_status a owl:DatatypeProperty ;
    rdfs:label "availability_status" ;
    rdfs:range xsd:string ;
    skos:definition "Current availability of the resource." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:awareness_program a owl:ObjectProperty ;
    rdfs:label "awareness_program" ;
    rdfs:range iso27001:AwarenessProgram ;
    skos:definition "Reference to the awareness program." ;
    skos:exactMatch iso42001:awareness_program ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:categorized_as_incident a owl:DatatypeProperty ;
    rdfs:label "categorized_as_incident" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the event was categorized as an incident." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:certification_body a owl:DatatypeProperty ;
    rdfs:label "certification_body" ;
    rdfs:range xsd:string ;
    skos:definition "Accredited certification body." ;
    skos:exactMatch iso42001:certification_body ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:certification_date a owl:DatatypeProperty ;
    rdfs:label "certification_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date certification was achieved." ;
    skos:exactMatch iso42001:certification_date ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:certification_status a owl:DatatypeProperty ;
    rdfs:label "certification_status" ;
    rdfs:range xsd:string ;
    skos:definition "Current certification status." ;
    skos:exactMatch iso42001:certification_status ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:change_control_method a owl:DatatypeProperty ;
    rdfs:label "change_control_method" ;
    rdfs:range xsd:string ;
    skos:definition "Method used for control of changes (e.g., version control) of the documented information, per Clause 7.5.3 e)." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "7.5.3" .

iso27001:change_control_requirements a owl:DatatypeProperty ;
    rdfs:label "change_control_requirements" ;
    rdfs:range xsd:string ;
    skos:definition "Requirements for controlling changes." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:clause_reference a owl:DatatypeProperty ;
    rdfs:label "clause_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Reference to standard clause." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:climate_change_relevant a owl:DatatypeProperty ;
    rdfs:label "climate_change_relevant" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether climate change has been determined to be a relevant issue for the organization's context, per Clause 4.1 as amended by Amd. 1:2024." ;
    skos:exactMatch iso42001:climate_change_relevant ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "Set true if climate change is identified as a relevant external or internal issue",
        "When true, capture details in context_external_issues or context_internal_issues" ;
    iso27001:iso27001_amendment "Amd. 1:2024" ;
    iso27001:iso27001_clause "4.1" .

iso27001:closure_datetime a owl:DatatypeProperty ;
    rdfs:label "closure_datetime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date and time of incident closure." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:closure_evidence a owl:DatatypeProperty ;
    rdfs:label "closure_evidence" ;
    rdfs:range xsd:string ;
    skos:definition "Evidence supporting closure." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:closure_status a owl:DatatypeProperty ;
    rdfs:label "closure_status" ;
    rdfs:range xsd:string ;
    skos:definition "Status of finding closure." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:communication_date a owl:DatatypeProperty ;
    rdfs:label "communication_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date when the policy was communicated." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:communication_needs a owl:DatatypeProperty ;
    rdfs:label "communication_needs" ;
    rdfs:range xsd:string ;
    skos:definition "Communication requirements for this party." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:communication_plan a owl:ObjectProperty ;
    rdfs:label "communication_plan" ;
    rdfs:range iso27001:CommunicationPlan ;
    skos:definition "Reference to the communication plan." ;
    skos:exactMatch iso42001:communication_plan ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:competency_assessment_date a owl:DatatypeProperty ;
    rdfs:label "competency_assessment_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date of last competency assessment." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:completion_date a owl:DatatypeProperty ;
    rdfs:label "completion_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date when implementation was completed." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:completion_tracking a owl:DatatypeProperty ;
    rdfs:label "completion_tracking" ;
    rdfs:range xsd:string ;
    skos:definition "How completion is tracked." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:consequences_addressed a owl:DatatypeProperty ;
    rdfs:label "consequences_addressed" ;
    rdfs:range xsd:string ;
    skos:definition "How consequences were dealt with." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "10.2 a) 2)" .

iso27001:contact_information a owl:DatatypeProperty ;
    rdfs:label "contact_information" ;
    rdfs:range xsd:string ;
    skos:definition "Contact details for the party." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:context_changes a owl:DatatypeProperty ;
    rdfs:label "context_changes" ;
    rdfs:range xsd:string ;
    skos:definition "Changes in context since last review." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "9.3.2 b)" .

iso27001:control_category a owl:ObjectProperty ;
    rdfs:label "control_category" ;
    rdfs:range iso27001:ControlCategory ;
    skos:definition "Domain category of the control." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:control_id a owl:ObjectProperty ;
    rdfs:label "control_id" ;
    rdfs:range iso27001:AnnexAControlId ;
    skos:closeMatch oscal:Control ;
    skos:definition "Control identifier from Annex A (e.g., a_5_1, a_8_24)." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "Enumerated permissible values mirror the 93 Annex A controls",
        "Provides stable per-control IRIs for SSSOM mapping subjects" .

iso27001:control_owner a owl:DatatypeProperty ;
    rdfs:label "control_owner" ;
    rdfs:range xsd:string ;
    skos:definition "Person responsible for the control." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:control_selection_criteria a owl:DatatypeProperty ;
    rdfs:label "control_selection_criteria" ;
    rdfs:range xsd:string ;
    skos:definition "Criteria for selecting controls." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:control_text a owl:DatatypeProperty ;
    rdfs:label "control_text" ;
    rdfs:range xsd:string ;
    skos:definition "Organization-authored control statement or external control summary." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:control_title a owl:DatatypeProperty ;
    rdfs:label "control_title" ;
    rdfs:range xsd:string ;
    skos:definition "Title of the control." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:cost a owl:DatatypeProperty ;
    rdfs:label "cost" ;
    rdfs:range xsd:string ;
    skos:definition "Cost of the resource." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:created_date a owl:DatatypeProperty ;
    rdfs:label "created_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date when the entity was created." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:criticality a owl:DatatypeProperty ;
    rdfs:label "criticality" ;
    rdfs:range xsd:string ;
    skos:definition "Criticality rating of the asset." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:delegation_rules a owl:DatatypeProperty ;
    rdfs:label "delegation_rules" ;
    rdfs:range xsd:string ;
    skos:definition "Rules for delegating responsibilities." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "Detailed description of the entity." ;
    skos:exactMatch iso42001:description ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "Should provide sufficient detail for understanding without external reference" .

iso27001:detected_by a owl:DatatypeProperty ;
    rdfs:label "detected_by" ;
    rdfs:range xsd:string ;
    skos:definition "Person or process that detected the nonconformity." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:detection_date a owl:DatatypeProperty ;
    rdfs:label "detection_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date the nonconformity was detected." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:detection_method a owl:DatatypeProperty ;
    rdfs:label "detection_method" ;
    rdfs:range xsd:string ;
    skos:definition "How the incident was detected." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:relatedMatch ocsf:observables .

iso27001:document_reference a owl:DatatypeProperty ;
    rdfs:label "document_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Unique reference number for document control." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "Per 7.5.2 a) identification and description" .

iso27001:document_type a owl:ObjectProperty ;
    rdfs:label "document_type" ;
    rdfs:range iso27001:DocumentType ;
    skos:definition "Classification of the documented information." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:effective_date a owl:DatatypeProperty ;
    rdfs:label "effective_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date when the document becomes effective." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:effectiveness_criteria a owl:DatatypeProperty ;
    rdfs:label "effectiveness_criteria" ;
    rdfs:range xsd:string ;
    skos:definition "Criteria for evaluating effectiveness." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:effectiveness_measures a owl:DatatypeProperty ;
    rdfs:label "effectiveness_measures" ;
    rdfs:range xsd:string ;
    skos:definition "How effectiveness is measured." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:effectiveness_rating a owl:DatatypeProperty ;
    rdfs:label "effectiveness_rating" ;
    rdfs:range xsd:string ;
    skos:definition "Rating of control effectiveness." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:effectiveness_review_date a owl:DatatypeProperty ;
    rdfs:label "effectiveness_review_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date effectiveness was reviewed." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "10.2 d)" .

iso27001:effectiveness_verified a owl:DatatypeProperty ;
    rdfs:label "effectiveness_verified" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether effectiveness was verified." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:employee_count a owl:DatatypeProperty ;
    rdfs:label "employee_count" ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Approximate number of employees." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:event_datetime a owl:DatatypeProperty ;
    rdfs:label "event_datetime" ;
    rdfs:range xsd:dateTime ;
    skos:closeMatch ocsf:time ;
    skos:definition "Date and time of the event." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:event_description a owl:DatatypeProperty ;
    rdfs:label "event_description" ;
    rdfs:range xsd:string ;
    skos:definition "Description of the event." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:exclusion_justification a owl:DatatypeProperty ;
    rdfs:label "exclusion_justification" ;
    rdfs:range xsd:string ;
    skos:definition "Justification for excluding the control." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "6.1.3 d)" .

iso27001:expected_benefit a owl:DatatypeProperty ;
    rdfs:label "expected_benefit" ;
    rdfs:range xsd:string ;
    skos:definition "Expected benefit from implementation." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:external_origin a owl:DatatypeProperty ;
    rdfs:label "external_origin" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the documented information is of external origin and has been identified as necessary for the planning and operation of the ISMS, per Clause 7.5.3." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "7.5.3" .

iso27001:external_origin_source a owl:DatatypeProperty ;
    rdfs:label "external_origin_source" ;
    rdfs:range xsd:string ;
    skos:definition "Source or provider of the externally originated documented information, per Clause 7.5.3." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "7.5.3" .

iso27001:finding_description a owl:DatatypeProperty ;
    rdfs:label "finding_description" ;
    rdfs:range xsd:string ;
    skos:definition "Description of the finding." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:finding_type a owl:ObjectProperty ;
    rdfs:label "finding_type" ;
    rdfs:range iso27001:AuditFindingType ;
    skos:definition "Type of audit finding." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:governing_body a owl:DatatypeProperty ;
    rdfs:label "governing_body" ;
    rdfs:range xsd:string ;
    skos:definition "The governing body to which top management reports, where applicable (e.g., board of directors). Referenced in ISO/IEC 27001:2022 Clause 5.1 NOTE." ;
    skos:exactMatch iso42001:governing_body ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "5.1 NOTE" .

iso27001:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Unique identifier for the entity." ;
    skos:exactMatch iso42001:id ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "Should use consistent URI/CURIE format across the dataset" .

iso27001:identification_date a owl:DatatypeProperty ;
    rdfs:label "identification_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date identified." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:identified_by a owl:DatatypeProperty ;
    rdfs:label "identified_by" ;
    rdfs:range xsd:string ;
    skos:definition "Person who identified it." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:impact a owl:ObjectProperty ;
    rdfs:label "impact" ;
    rdfs:range iso27001:ImpactRating ;
    skos:definition "Assessed impact if risk materializes." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "6.1.2 d) 1)" .

iso27001:impact_scale a owl:DatatypeProperty ;
    rdfs:label "impact_scale" ;
    rdfs:range xsd:string ;
    skos:definition "Scale used for impact rating." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:implementation_date a owl:DatatypeProperty ;
    rdfs:label "implementation_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date the control was implemented." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:implementation_evidence a owl:DatatypeProperty ;
    rdfs:label "implementation_evidence" ;
    rdfs:range xsd:string ;
    skos:definition "Evidence of control implementation." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:implementation_guidance a owl:DatatypeProperty ;
    rdfs:label "implementation_guidance" ;
    rdfs:range xsd:string ;
    skos:definition "Organization-authored implementation notes for the control." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    skos:note "May reference internal standards, procedures, or external licensed sources" .

iso27001:implementation_plan a owl:DatatypeProperty ;
    rdfs:label "implementation_plan" ;
    rdfs:range xsd:string ;
    skos:definition "Plan for implementing the improvement." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:implementation_timeline a owl:DatatypeProperty ;
    rdfs:label "implementation_timeline" ;
    rdfs:range xsd:string ;
    skos:definition "Timeline for implementation." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:implemented_count a owl:DatatypeProperty ;
    rdfs:label "implemented_count" ;
    rdfs:range xsd:unsignedShort ;
    skos:definition "Number of implemented controls." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:improvement_description a owl:DatatypeProperty ;
    rdfs:label "improvement_description" ;
    rdfs:range xsd:string ;
    skos:definition "Description of the improvement." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:improvement_source a owl:DatatypeProperty ;
    rdfs:label "improvement_source" ;
    rdfs:range xsd:string ;
    skos:definition "Source of the improvement opportunity." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:incident_category a owl:ObjectProperty ;
    rdfs:label "incident_category" ;
    rdfs:range iso27001:SecurityIncidentCategory ;
    skos:closeMatch ocsf:category_uid ;
    skos:definition "Category of incident." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:annex_a_reference "A.5.24" .

iso27001:incident_datetime a owl:DatatypeProperty ;
    rdfs:label "incident_datetime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date and time the incident occurred or was detected." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:incident_description a owl:DatatypeProperty ;
    rdfs:label "incident_description" ;
    rdfs:range xsd:string ;
    skos:definition "Description of the incident." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:inclusion_justification a owl:DatatypeProperty ;
    rdfs:label "inclusion_justification" ;
    rdfs:range xsd:string ;
    skos:definition "Justification for including the control." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "6.1.3 d)" .

iso27001:industry_sector a owl:DatatypeProperty ;
    rdfs:label "industry_sector" ;
    rdfs:range xsd:string ;
    skos:definition "Primary industry sector of the organization." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:information_security_policy a owl:ObjectProperty ;
    rdfs:label "information_security_policy" ;
    rdfs:range iso27001:InformationSecurityPolicy ;
    skos:closeMatch iso42001:ai_policy ;
    skos:definition "Reference to the information security policy." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "5.2" .

iso27001:inherent_risk_level a owl:ObjectProperty ;
    rdfs:label "inherent_risk_level" ;
    rdfs:range iso27001:RiskLevel ;
    skos:definition "Risk level before controls are applied." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:initial_assessment a owl:DatatypeProperty ;
    rdfs:label "initial_assessment" ;
    rdfs:range xsd:string ;
    skos:definition "Initial assessment of the event." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:interested_party_changes a owl:DatatypeProperty ;
    rdfs:label "interested_party_changes" ;
    rdfs:range xsd:string ;
    skos:definition "Changes in interested party requirements." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "9.3.2 c)" .

iso27001:interested_party_feedback a owl:DatatypeProperty ;
    rdfs:label "interested_party_feedback" ;
    rdfs:range xsd:string ;
    skos:definition "Feedback from interested parties considered in the management review." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "9.3.2 e)" .

iso27001:is_applicable a owl:DatatypeProperty ;
    rdfs:label "is_applicable" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the control is applicable." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:isms_changes_required a owl:DatatypeProperty ;
    rdfs:label "isms_changes_required" ;
    rdfs:range xsd:string ;
    skos:closeMatch iso42001:aims_changes_required ;
    skos:definition "Changes to ISMS required as a result." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "10.2 e)" .

iso27001:last_policy_review_date a owl:DatatypeProperty ;
    rdfs:label "last_policy_review_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date of the most recent information security policy review." ;
    skos:exactMatch iso42001:last_policy_review_date ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> ;
    iso27001:iso27001_clause "5.2 / 9.3" .

iso27001:last_review_date a owl:DatatypeProperty ;
    rdfs:label "last_review_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date of last review." ;
    skos:inScheme <https://w3id.org/lmodel/iso27001> .

iso27001:last_test_date a owl:DatatypeProperty ;
