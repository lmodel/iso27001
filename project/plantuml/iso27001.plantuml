@startuml
skinparam nodesep 10
hide circle
hide empty members
abstract "IsmsRecord" [[{Anything the ISMS keeps a record of that other records can refer to: it has an identifier, a title and a description.}]] {
    {field} isms_id : uriorcurie  
    {field} title : string  
    {field} description : string  
}
class "IsmsTopicSpecificPolicy" [[{A policy on one topic of information security, such as access control or backup, that supports the information security policy.}]] {
