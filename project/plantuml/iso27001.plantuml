    {field} document_classification : string  
    {field} document_retention : isms_duration  
    {field} document_distribution : string  [0..*]
    {field} document_storage : string  
    {field} document_change_control : string  
    {field} document_external_origin : boolean  
    {field} document_external_source : string  
    {field} isms_id(i) : uriorcurie  
    {field} title(i) : string  
    {field} description(i) : string  
}
