    {field} incident_response_actions : string  [0..*]
    {field} incident_containment_actions : string  [0..*]
    {field} incident_eradication_actions : string  [0..*]
    {field} incident_recovery_actions : string  [0..*]
    {field} incident_root_cause : string  
    {field} incident_lessons_learned : string  [0..*]
    {field} incident_evidence : string  [0..*]
    {field} incident_notification_required : boolean  
    {field} incident_notifications : string  [0..*]
    {field} incident_closed_at : datetime  
    {field} incident_review : string  
    {field} event_type(i) : string  
    {field} event_occurred_at(i) : datetime  
    {field} event_reporter(i) : string  
    {field} event_assessment(i) : string  
    {field} isms_id(i) : uriorcurie  
    {field} title(i) : string  
    {field} description(i) : string  
}
"IsmsSecurityEvent" --> "0..*" "IsmsAsset" : "affected_assets"
