PREFIX linkml: <https://w3id.org/linkml/>
PREFIX iso27001: <https://w3id.org/lmodel/iso27001/>
PREFIX schema: <http://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX oscal: <https://w3id.org/lmodel/oscal/>
PREFIX nist_sp_800_53: <https://w3id.org/lmodel/nist-sp-800-53/>
PREFIX spdx_core: <https://spdx.org/rdf/3.0.1/terms/Core/>
PREFIX spdx_software: <https://spdx.org/rdf/3.0.1/terms/Software/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX shex: <http://www.w3.org/ns/shex#>

SELECT ?g ?s ?p WHERE {
 GRAPH ?g {
  ?s rdf:type iso27001:IsmsControl ;
     ?p ?o .
  FILTER ( ?p NOT IN (
   iso27001:relevant_controls,
   iso27001:implementation_state,
   iso27001:control_annex_a_controls,
   iso27001:control_theme,
   iso27001:control_text,
   iso27001:control_guidance,
   iso27001:control_threats,
   iso27001:control_asset_types,
   iso27001:control_owner,
   iso27001:control_implementation_date,
   iso27001:control_effectiveness,
   iso27001:control_last_tested,
   iso27001:control_evidence,
   iso27001:isms_id,
   schema:name,
   schema:description,
   rdf:type ))
 }
 
} 





