PREFIX linkml: <https://w3id.org/linkml/>
PREFIX iso27001: <https://w3id.org/lmodel/iso27001/>
PREFIX schema: <http://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX oscal: <https://w3id.org/lmodel/oscal/>
PREFIX nist_sp_800_53: <https://w3id.org/lmodel/nist-sp-800-53/>
PREFIX spdx_core: <https://spdx.org/rdf/3.0.1/terms/Core/>
PREFIX spdx_software: <https://spdx.org/rdf/3.0.1/terms/Software/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX shex: <http://www.w3.org/ns/shex#>

SELECT ?g ?s ?p WHERE {
 GRAPH ?g {
  ?s rdf:type iso27001:IsmsAuditFinding ;
     ?p ?o .
  FILTER ( ?p NOT IN (
   iso27001:finding_type,
   iso27001:finding_requirement,
   iso27001:finding_control,
   iso27001:finding_evidence,
   iso27001:finding_root_cause,
   iso27001:finding_risk,
   iso27001:finding_recommendation,
   iso27001:finding_auditee_response,
   iso27001:finding_corrective_action,
   iso27001:finding_closure_status,
   iso27001:finding_closure_date,
   iso27001:isms_id,
   schema:name,
   schema:description,
   rdf:type ))
 }
 
} 



