PREFIX linkml: <https://w3id.org/linkml/>
PREFIX iso27001: <https://w3id.org/lmodel/iso27001/>
PREFIX iso27002: <https://w3id.org/lmodel/iso27002/>
PREFIX iso: <https://www.iso.org/standard/>
PREFIX schema: <http://schema.org/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX cis_controls: <https://w3id.org/lmodel/cis-controls/>
PREFIX oscal: <https://w3id.org/lmodel/oscal/>
PREFIX nist_sp_800_53: <https://w3id.org/lmodel/nist-sp-800-53/>
PREFIX nist_csf_v2: <https://w3id.org/lmodel/nist-csf-v2/>
PREFIX nist_sp_800_171: <https://w3id.org/lmodel/nist-sp-800-171/>
PREFIX nist_sp_800_218: <https://w3id.org/lmodel/nist-sp-800-218/>
PREFIX attack: <https://w3id.org/lmodel/attack/>
PREFIX d3f: <https://d3fend.mitre.org/ontologies/d3fend.owl#>
PREFIX slsa: <https://w3id.org/lmodel/slsa/>
PREFIX stix: <https://w3id.org/lmodel/stix/>
PREFIX ocsf: <https://w3id.org/lmodel/ocsf/>
PREFIX spdx: <https://w3id.org/lmodel/spdx/>
PREFIX capec: <https://w3id.org/lmodel/capec/>
PREFIX cwe: <https://w3id.org/lmodel/cwe/>
PREFIX cve: <https://w3id.org/lmodel/cve/>
PREFIX nvd: <https://w3id.org/lmodel/nist-nvd/>
PREFIX kev_catalog: <https://w3id.org/lmodel/kev-catalog/>
PREFIX iso29100: <https://w3id.org/lmodel/iso29100/>
PREFIX semapv: <https://w3id.org/semapv/vocab/>
PREFIX iso42001: <https://w3id.org/lmodel/iso42001/>

SELECT ?g ?s ?p WHERE {
 GRAPH ?g {
  ?s rdf:type iso27001:InformationSecurityManagementSystem ;
     ?p ?o .
  FILTER ( ?p NOT IN (
   iso27001:organization,
   iso27001:top_management,
   iso27001:governing_body,
   iso27001:leadership_commitment_evidence,
   iso27001:scope_statement,
   iso27001:scope_boundaries,
   iso27001:scope_exclusions,
   iso27001:interfaces_and_dependencies,
   iso27001:processes_and_interactions,
   iso27001:context_internal_issues,
   iso27001:context_external_issues,
   iso27001:interested_parties,
   iso27001:information_security_policy,
   iso27001:objectives,
   iso27001:risks_and_opportunities_actions,
   iso27001:planned_changes,
   iso27001:externally_provided_services,
   iso27001:risk_assessment_process,
   iso27001:risk_treatment_process,
   iso27001:statement_of_applicability,
   iso27001:controls,
   iso27001:roles,
   iso27001:resources,
   iso27001:competence_records,
   iso27001:awareness_program,
   iso27001:communication_plan,
   iso27001:documented_information_register,
   iso27001:operational_procedures,
   iso27001:risk_assessments,
   iso27001:risk_treatment_plans,
   iso27001:monitoring_program,
   iso27001:internal_audits,
   iso27001:management_reviews,
   iso27001:nonconformities,
   iso27001:corrective_actions,
   iso27001:improvements,
   iso27001:certification_status,
   iso27001:certification_body,
   iso27001:certification_date,
   iso27001:recertification_date,
   iso27001:id,
   iso27001:name,
   iso27001:description,
   iso27001:created_date,
   iso27001:modified_date,
   iso27001:version,
   rdf:type ))
 }
 
} 





