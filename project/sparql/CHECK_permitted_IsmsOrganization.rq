PREFIX linkml: <https://w3id.org/linkml/>
PREFIX iso27001: <https://w3id.org/lmodel/iso27001/>
PREFIX schema: <http://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX oscal: <https://w3id.org/lmodel/oscal/>
PREFIX nist_sp_800_53: <https://w3id.org/lmodel/nist-sp-800-53/>
PREFIX spdx_core: <https://spdx.org/rdf/3.0.1/terms/Core/>
PREFIX spdx_software: <https://spdx.org/rdf/3.0.1/terms/Software/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX shex: <http://www.w3.org/ns/shex#>

SELECT ?g ?s ?p WHERE {
 GRAPH ?g {
  ?s rdf:type iso27001:IsmsOrganization ;
     ?p ?o .
  FILTER ( ?p NOT IN (
   iso27001:organization_legal_name,
   iso27001:organization_trading_names,
   iso27001:organization_kind,
   iso27001:organization_sector,
   iso27001:organization_size,
   iso27001:organization_employee_count,
   iso27001:organization_locations,
   iso27001:organization_jurisdictions,
   iso27001:organization_parent,
   iso27001:organization_subsidiaries,
   iso27001:organization_climate_change_relevant,
   iso27001:isms_id,
   schema:name,
   schema:description,
   rdf:type ))
 }
 
} 

























