PREFIX linkml: <https://w3id.org/linkml/>
PREFIX iso27001: <https://w3id.org/lmodel/iso27001/>
PREFIX schema: <http://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX oscal: <https://w3id.org/lmodel/oscal/>
PREFIX nist_sp_800_53: <https://w3id.org/lmodel/nist-sp-800-53/>
PREFIX spdx_core: <https://spdx.org/rdf/3.0.1/terms/Core/>
PREFIX spdx_software: <https://spdx.org/rdf/3.0.1/terms/Software/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX shex: <http://www.w3.org/ns/shex#>

SELECT ?g ?s ?p WHERE {
 GRAPH ?g {
  ?s rdf:type iso27001:IsmsObjective ;
     ?p ?o .
  FILTER ( ?p NOT IN (
   iso27001:responsible_role,
   iso27001:relevant_controls,
   iso27001:objective_statement,
   iso27001:objective_target,
   iso27001:objective_current_value,
   iso27001:objective_metric,
   iso27001:objective_measurement_method,
   iso27001:objective_measurement_frequency,
   iso27001:objective_target_date,
   iso27001:objective_achievement,
   iso27001:objective_risks,
   iso27001:objective_action_plan,
   iso27001:objective_resources,
   iso27001:isms_id,
   schema:name,
   schema:description,
   rdf:type ))
 }
 
} 





