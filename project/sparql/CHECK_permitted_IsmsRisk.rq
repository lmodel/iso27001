PREFIX linkml: <https://w3id.org/linkml/>
PREFIX iso27001: <https://w3id.org/lmodel/iso27001/>
PREFIX schema: <http://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX oscal: <https://w3id.org/lmodel/oscal/>
PREFIX nist_sp_800_53: <https://w3id.org/lmodel/nist-sp-800-53/>
PREFIX spdx_core: <https://spdx.org/rdf/3.0.1/terms/Core/>
PREFIX spdx_software: <https://spdx.org/rdf/3.0.1/terms/Software/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX shex: <http://www.w3.org/ns/shex#>

SELECT ?g ?s ?p WHERE {
 GRAPH ?g {
  ?s rdf:type iso27001:IsmsRisk ;
     ?p ?o .
  FILTER ( ?p NOT IN (
   iso27001:affected_assets,
   iso27001:affected_security_properties,
   iso27001:risk_source,
   iso27001:risk_threat,
   iso27001:risk_vulnerability,
   iso27001:risk_owner,
   iso27001:risk_likelihood,
   iso27001:risk_impact,
   iso27001:risk_inherent_level,
   iso27001:risk_existing_controls,
   iso27001:risk_residual_level,
   iso27001:risk_treatment_option,
   iso27001:risk_treatment_priority,
   iso27001:isms_id,
   schema:name,
   schema:description,
   rdf:type ))
 }
 
} 





