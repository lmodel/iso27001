<https://w3id.org/lmodel/iso27001/InformationSecurityIncident> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/iso27001/annex_a_controls> ;
    skos:closeMatch "iso42001:AIIncident"^^xsd:anyURI,
        "ocsf:IncidentFinding"^^xsd:anyURI,
        "stix:Incident"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    skos:note "Captures response lifecycle, evidence references, and lessons learned",
        "Reference: ISO/IEC 27001:2022 Annex A control 5.26; ISO/IEC 27002:2022 Clause 5.26. ISO/IEC standards text is copyright ISO - not reproduced here." ;
    skos:relatedMatch "oscal:PoamItem"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "5.26" ;
            linkml:tag "annex_a_control"^^xsd:anyURI ] ;
    linkml:class_uri "https://w3id.org/lmodel/iso27001/InformationSecurityIncident"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/InformationSecurityIncident"^^xsd:anyURI ;
    linkml:description "An information security incident per A.5.26, requiring response per documented procedures." ;
    linkml:is_a <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/iso27001/NamedEntity_id>,
        <https://w3id.org/lmodel/iso27001/affected_assets>,
        <https://w3id.org/lmodel/iso27001/affected_cia>,
        <https://w3id.org/lmodel/iso27001/closure_datetime>,
        <https://w3id.org/lmodel/iso27001/containment_actions>,
        <https://w3id.org/lmodel/iso27001/created_date>,
        <https://w3id.org/lmodel/iso27001/description>,
        <https://w3id.org/lmodel/iso27001/detection_method>,
        <https://w3id.org/lmodel/iso27001/eradication_actions>,
        <https://w3id.org/lmodel/iso27001/evidence_collected>,
        <https://w3id.org/lmodel/iso27001/incident_category>,
        <https://w3id.org/lmodel/iso27001/incident_datetime>,
