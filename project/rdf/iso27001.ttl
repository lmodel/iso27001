        <https://w3id.org/lmodel/iso27001/responsible_parties>,
        <https://w3id.org/lmodel/iso27001/retention_period>,
        <https://w3id.org/lmodel/iso27001/review_date>,
        <https://w3id.org/lmodel/iso27001/risk_owner_approval>,
        <https://w3id.org/lmodel/iso27001/risks_addressed>,
        <https://w3id.org/lmodel/iso27001/status>,
        <https://w3id.org/lmodel/iso27001/storage_and_preservation>,
        <https://w3id.org/lmodel/iso27001/treatment_actions>,
        <https://w3id.org/lmodel/iso27001/version> .

<https://w3id.org/lmodel/iso27001/Risk> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/iso27001/risk_management> ;
    skos:closeMatch "cve:CveRecord"^^xsd:anyURI,
        "iso42001:AIRisk"^^xsd:anyURI,
        "kev_catalog:KevVulnerability"^^xsd:anyURI,
        "nvd:CveItem"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    skos:note "Links threat, vulnerability, and affected assets to risk ownership",
        "Reference: ISO/IEC 27001:2022 Clause 6.1.2. ISO/IEC standards text is copyright ISO - not reproduced here.",
        "Supports likelihood, impact, treatment, and residual risk tracking" ;
    skos:relatedMatch "attack:AttackTechnique"^^xsd:anyURI,
        "capec:AttackPattern"^^xsd:anyURI,
        "cwe:Weakness"^^xsd:anyURI,
        "iso29100:PrivacyRisk"^^xsd:anyURI,
        "ocsf:VulnerabilityDetails"^^xsd:anyURI,
        "stix:ThreatActor"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "6.1.2" ;
            linkml:tag "iso27001_clause"^^xsd:anyURI ] ;
    linkml:class_uri "https://w3id.org/lmodel/iso27001/Risk"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/Risk"^^xsd:anyURI ;
    linkml:description "An identified information security risk that may affect information security properties within the ISMS scope." ;
    linkml:is_a <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/iso27001/NamedEntity_id>,
        <https://w3id.org/lmodel/iso27001/affected_assets>,
        <https://w3id.org/lmodel/iso27001/affected_cia_properties>,
        <https://w3id.org/lmodel/iso27001/created_date>,
        <https://w3id.org/lmodel/iso27001/description>,
        <https://w3id.org/lmodel/iso27001/existing_controls>,
        <https://w3id.org/lmodel/iso27001/impact>,
        <https://w3id.org/lmodel/iso27001/inherent_risk_level>,
        <https://w3id.org/lmodel/iso27001/likelihood>,
        <https://w3id.org/lmodel/iso27001/modified_date>,
        <https://w3id.org/lmodel/iso27001/name>,
        <https://w3id.org/lmodel/iso27001/related_treatment_plan>,
        <https://w3id.org/lmodel/iso27001/residual_risk_level>,
        <https://w3id.org/lmodel/iso27001/risk_owner>,
        <https://w3id.org/lmodel/iso27001/risk_source>,
        <https://w3id.org/lmodel/iso27001/risk_treatment_option>,
        <https://w3id.org/lmodel/iso27001/threat_description>,
        <https://w3id.org/lmodel/iso27001/treatment_priority>,
        <https://w3id.org/lmodel/iso27001/version>,
        <https://w3id.org/lmodel/iso27001/vulnerability_description> .

<https://w3id.org/lmodel/iso27001/NamedEntity> a linkml:ClassDefinition ;
    skos:exactMatch "iso42001:NamedEntity"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    skos:note "All concrete classes should inherit from this or a subclass",
        "Ensures consistent identification across the schema" ;
    linkml:abstract true ;
    linkml:class_uri "https://w3id.org/lmodel/iso27001/NamedEntity"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/NamedEntity"^^xsd:anyURI ;
    linkml:description "Abstract base class for all entities with an identifier, name, and description. Provides common identification and documentation slots." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/iso27001/NamedEntity_id>,
        <https://w3id.org/lmodel/iso27001/created_date>,
        <https://w3id.org/lmodel/iso27001/description>,
        <https://w3id.org/lmodel/iso27001/modified_date>,
        <https://w3id.org/lmodel/iso27001/name>,
        <https://w3id.org/lmodel/iso27001/version> .

<https://w3id.org/lmodel/iso27001/NamedEntity_id> a linkml:SlotDefinition ;
    skos:exactMatch "https://w3id.org/lmodel/iso42001/id"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    skos:note "Should use consistent URI/CURIE format across the dataset" ;
    skos:prefLabel "id" ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/id"^^xsd:anyURI ;
    linkml:description "Unique identifier for this entity instance." ;
    linkml:domain <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:domain_of <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:examples [ a linkml:Example ;
            skos:example "iso27001:control-5.1" ],
        [ a linkml:Example ;
            skos:example "iso27001:risk-001" ] ;
    linkml:identifier true ;
    linkml:is_a <https://w3id.org/lmodel/iso27001/id> ;
    linkml:is_usage_slot true ;
    linkml:owner <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:range <https://w3id.org/lmodel/iso27001/uriorcurie> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/iso27001/id"^^xsd:anyURI ;
    linkml:usage_slot_name "id" .

<https://w3id.org/lmodel/iso27001/created_date> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/created_date"^^xsd:anyURI ;
    linkml:description "Date when the entity was created." ;
    linkml:domain_of <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:owner <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:range <https://w3id.org/lmodel/iso27001/date> ;
    linkml:slot_uri "https://w3id.org/lmodel/iso27001/created_date"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/date> a linkml:TypeDefinition ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date\".",
        "URI is dateTime because OWL reasoners don't work with straight date or time" ;
    skos:exactMatch "schema:Date"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
    linkml:base "XSDDate" ;
    linkml:definition_uri "https://w3id.org/linkml/Date"^^xsd:anyURI ;
    linkml:description "a date (year, month and day) in an idealized calendar" ;
    linkml:imported_from "linkml:types" ;
    linkml:repr "str" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#date"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/description> a linkml:SlotDefinition ;
    skos:exactMatch "https://w3id.org/lmodel/iso42001/description"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    skos:note "Should provide sufficient detail for understanding without external reference" ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/description"^^xsd:anyURI ;
    linkml:description "Detailed description of the entity." ;
    linkml:domain_of <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:owner <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:range <https://w3id.org/lmodel/iso27001/string> ;
    linkml:slot_uri "https://w3id.org/lmodel/iso27001/description"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/modified_date> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/modified_date"^^xsd:anyURI ;
    linkml:description "Date when the entity was last modified." ;
    linkml:domain_of <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:owner <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:range <https://w3id.org/lmodel/iso27001/date> ;
    linkml:slot_uri "https://w3id.org/lmodel/iso27001/modified_date"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/name> a linkml:SlotDefinition ;
    skos:exactMatch "https://w3id.org/lmodel/iso42001/name"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/name"^^xsd:anyURI ;
    linkml:description "Human-readable name or title." ;
    linkml:domain_of <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:owner <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:range <https://w3id.org/lmodel/iso27001/string> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/iso27001/name"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/version> a linkml:SlotDefinition ;
    skos:exactMatch "https://w3id.org/lmodel/iso42001/version"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    skos:note "Supports document control requirements per 7.5.3 e)" ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/version"^^xsd:anyURI ;
    linkml:description "Version identifier for the entity." ;
    linkml:domain_of <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:examples [ a linkml:Example ;
            skos:example "1.0" ],
        [ a linkml:Example ;
            skos:example "2.3.1" ] ;
    linkml:owner <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:range <https://w3id.org/lmodel/iso27001/string> ;
    linkml:slot_uri "https://w3id.org/lmodel/iso27001/version"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/SecurityControl> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/iso27001/annex_a_controls> ;
    skos:closeMatch "iso42001:AIReferenceControl"^^xsd:anyURI,
        "nist_csf_v2:CSFSubcategory"^^xsd:anyURI,
        "nist_sp_800_53:Control"^^xsd:anyURI,
        "oscal:Control"^^xsd:anyURI,
        "stix:CourseOfAction"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    skos:note "93 controls organized in four domains (organizational, people, physical, technological)",
        "Controls are referenced in risk treatment and SoA",
        "Reference: ISO/IEC 27001:2022 Annex A; ISO/IEC 27002:2022 Clauses 5-8. ISO/IEC standards text is copyright ISO - not reproduced here.",
        "Supports organization-authored control statements and evidence links",
        "The control_text slot must contain organization-authored content only, not ISO standards text." ;
    skos:relatedMatch "attack:AttackMitigation"^^xsd:anyURI,
        "capec:Mitigation"^^xsd:anyURI,
        "cis_controls:Safeguard"^^xsd:anyURI,
        "d3f:DefensiveTechnique"^^xsd:anyURI,
        "nist_sp_800_171:Requirement"^^xsd:anyURI,
        "nist_sp_800_218:CatalogElement"^^xsd:anyURI,
        "ocsf:Compliance"^^xsd:anyURI,
        "slsa:BuildLevelEnum"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "6.1.3" ;
            linkml:tag "iso27001_clause"^^xsd:anyURI ],
        [ a linkml:Annotation ;
            skos:example "Annex A" ;
            linkml:tag "annex_reference"^^xsd:anyURI ] ;
    linkml:class_uri "https://w3id.org/lmodel/iso27001/SecurityControl"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/SecurityControl"^^xsd:anyURI ;
    linkml:description "A security control from Annex A of ISO/IEC 27001:2022, derived from ISO/IEC 27002:2022. Represents a measure that modifies risk." ;
    linkml:is_a <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/iso27001/NamedEntity_id>,
        <https://w3id.org/lmodel/iso27001/applicable_assets>,
        <https://w3id.org/lmodel/iso27001/applicable_threats>,
        <https://w3id.org/lmodel/iso27001/control_category>,
        <https://w3id.org/lmodel/iso27001/control_id>,
        <https://w3id.org/lmodel/iso27001/control_owner>,
        <https://w3id.org/lmodel/iso27001/control_text>,
        <https://w3id.org/lmodel/iso27001/control_title>,
        <https://w3id.org/lmodel/iso27001/created_date>,
        <https://w3id.org/lmodel/iso27001/description>,
        <https://w3id.org/lmodel/iso27001/effectiveness_rating>,
        <https://w3id.org/lmodel/iso27001/evidence_references>,
        <https://w3id.org/lmodel/iso27001/implementation_date>,
        <https://w3id.org/lmodel/iso27001/implementation_guidance>,
        <https://w3id.org/lmodel/iso27001/implementation_status>,
        <https://w3id.org/lmodel/iso27001/last_test_date>,
        <https://w3id.org/lmodel/iso27001/modified_date>,
        <https://w3id.org/lmodel/iso27001/name>,
        <https://w3id.org/lmodel/iso27001/related_controls>,
        <https://w3id.org/lmodel/iso27001/version> .

<https://w3id.org/lmodel/iso27001/InternalAudit> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/iso27001/documented_information>,
        <https://w3id.org/lmodel/iso27001/performance_evaluation> ;
