<https://w3id.org/lmodel/iso27001/accept> skos:altLabel "retain" ;
    linkml:description "Accept the risk without further treatment, within risk appetite. Requires risk owner approval." .

<https://w3id.org/lmodel/iso27001/account_compromise> skos:relatedMatch "attack:tactic_ta0006"^^xsd:anyURI ;
    linkml:description "Unauthorized control of a legitimate user or service account." .

<https://w3id.org/lmodel/iso27001/almost_certain> linkml:annotations [ skos:example "5" ;
            linkml:tag "numeric_value"^^xsd:anyURI ] ;
    linkml:description "Expected to occur in most circumstances (> 80% probability)." .

<https://w3id.org/lmodel/iso27001/availability> linkml:description "Property of being accessible and usable on demand by an authorized entity." .

<https://w3id.org/lmodel/iso27001/avoid> skos:altLabel "terminate" ;
    linkml:description "Eliminate the risk by removing the activity or asset that creates it." .

<https://w3id.org/lmodel/iso27001/combined> linkml:description "Audit performed jointly against two or more management system standards." .

<https://w3id.org/lmodel/iso27001/confidentiality> linkml:description "Property of information not being made available or disclosed to unauthorized entities." .

<https://w3id.org/lmodel/iso27001/configuration_error> linkml:description "Misconfiguration leading to security exposure." .

<https://w3id.org/lmodel/iso27001/critical> linkml:description "Severe risk threatening organizational objectives; requires immediate executive action and resource allocation." .

<https://w3id.org/lmodel/iso27001/cryptographic_failure> linkml:description "Weak, broken, or misused cryptography." .

<https://w3id.org/lmodel/iso27001/curie> a linkml:TypeDefinition ;
    dcterms:conformsTo "https://www.w3.org/TR/curie/" ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"." ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
    skos:note "in RDF serializations this MUST be expanded to a URI",
        "in non-RDF serializations MAY be serialized as the compact representation" ;
    linkml:base "Curie" ;
    linkml:definition_uri "https://w3id.org/linkml/Curie"^^xsd:anyURI ;
    linkml:description "a compact URI" ;
    linkml:imported_from "linkml:types" ;
    linkml:repr "str" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/data_breach> skos:relatedMatch "attack:tactic_ta0010"^^xsd:anyURI ;
    linkml:description "Confirmed disclosure of confidential or personal information." .

<https://w3id.org/lmodel/iso27001/data_loss> linkml:description "Loss of integrity or availability of information, including accidental deletion." .

<https://w3id.org/lmodel/iso27001/date_or_datetime> a linkml:TypeDefinition ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date_or_datetime\"." ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
    linkml:base "str" ;
    linkml:definition_uri "https://w3id.org/linkml/DateOrDatetime"^^xsd:anyURI ;
    linkml:description "Either a date or a datetime" ;
    linkml:imported_from "linkml:types" ;
    linkml:repr "str" ;
    linkml:uri "https://w3id.org/linkml/DateOrDatetime"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/decimal> a linkml:TypeDefinition ;
    skos:broadMatch "schema:Number"^^xsd:anyURI ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"decimal\"." ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
    linkml:base "Decimal" ;
    linkml:definition_uri "https://w3id.org/linkml/Decimal"^^xsd:anyURI ;
    linkml:description "A real number with arbitrary precision that conforms to the xsd:decimal specification" ;
    linkml:imported_from "linkml:types" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#decimal"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/denial_of_service> skos:closeMatch "capec:capec_125"^^xsd:anyURI ;
    skos:relatedMatch "attack:tactic_ta0040"^^xsd:anyURI ;
    linkml:description "Disruption of availability through volumetric, protocol, or application attacks." .

<https://w3id.org/lmodel/iso27001/double> a linkml:TypeDefinition ;
    skos:closeMatch "schema:Float"^^xsd:anyURI ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"double\"." ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
    linkml:base "float" ;
    linkml:definition_uri "https://w3id.org/linkml/Double"^^xsd:anyURI ;
    linkml:description "A real number that conforms to the xsd:double specification" ;
    linkml:imported_from "linkml:types" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/external_second_party> linkml:description "Audit conducted by a party with an interest in the organization (e.g., customer)." .

<https://w3id.org/lmodel/iso27001/external_third_party> linkml:description "Independent audit by a certification body or other third party." .

<https://w3id.org/lmodel/iso27001/float> a linkml:TypeDefinition ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"float\"." ;
    skos:exactMatch "schema:Float"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
    linkml:base "float" ;
    linkml:definition_uri "https://w3id.org/linkml/Float"^^xsd:anyURI ;
    linkml:description "A real number that conforms to the xsd:float specification" ;
    linkml:imported_from "linkml:types" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#float"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/guideline> linkml:description "Recommended practices that support policies and procedures." .

<https://w3id.org/lmodel/iso27001/high> linkml:description "Significant risk requiring priority treatment and escalation." .

<https://w3id.org/lmodel/iso27001/implemented> linkml:description "Control fully implemented and operational." .

<https://w3id.org/lmodel/iso27001/in_progress> linkml:description "Implementation actively underway but not yet complete." .

<https://w3id.org/lmodel/iso27001/insider_threat> skos:relatedMatch "attack:tactic_ta0004"^^xsd:anyURI,
        "stix:ThreatActor"^^xsd:anyURI ;
    linkml:description "Malicious or negligent action by an internal party." .

<https://w3id.org/lmodel/iso27001/integrity> linkml:description "Property of accuracy and completeness of information." .

<https://w3id.org/lmodel/iso27001/internal> linkml:description "First-party audit conducted by the organization itself per 9.2." .

<https://w3id.org/lmodel/iso27001/iso_14001> linkml:description "Environmental management systems." .

<https://w3id.org/lmodel/iso27001/iso_22301> linkml:description "Business continuity management systems." .

<https://w3id.org/lmodel/iso27001/iso_31000> linkml:description "Risk management - guidelines." .

<https://w3id.org/lmodel/iso27001/iso_9001> linkml:description "Quality management systems." .

<https://w3id.org/lmodel/iso27001/iso_iec_20000_1> linkml:description "IT service management systems." .

<https://w3id.org/lmodel/iso27001/iso_iec_27001> linkml:description "Information security management systems." .

<https://w3id.org/lmodel/iso27001/iso_iec_27017> linkml:description "Information security for cloud services." .

<https://w3id.org/lmodel/iso27001/iso_iec_27018> linkml:description "Protection of personally identifiable information in public clouds." .

<https://w3id.org/lmodel/iso27001/iso_iec_27701> linkml:description "Privacy information management systems (PIMS)." .

<https://w3id.org/lmodel/iso27001/iso_iec_42001> linkml:description "Artificial intelligence management systems." .

<https://w3id.org/lmodel/iso27001/jsonpath> a linkml:TypeDefinition ;
    dcterms:conformsTo "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html" ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"." ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
    linkml:base "str" ;
    linkml:definition_uri "https://w3id.org/linkml/Jsonpath"^^xsd:anyURI ;
    linkml:description "A string encoding a JSON Path. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded in tree form." ;
    linkml:imported_from "linkml:types" ;
    linkml:repr "str" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/jsonpointer> a linkml:TypeDefinition ;
    dcterms:conformsTo "https://datatracker.ietf.org/doc/html/rfc6901" ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpointer\"." ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
    linkml:base "str" ;
    linkml:definition_uri "https://w3id.org/linkml/Jsonpointer"^^xsd:anyURI ;
    linkml:description "A string encoding a JSON Pointer. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to a valid object within the current instance document when encoded in tree form." ;
    linkml:imported_from "linkml:types" ;
    linkml:repr "str" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/likely> linkml:annotations [ skos:example "4" ;
            linkml:tag "numeric_value"^^xsd:anyURI ] ;
    linkml:description "Probably will occur (50-80% probability)." .

<https://w3id.org/lmodel/iso27001/low> linkml:description "Minor risk manageable through routine procedures." .

<https://w3id.org/lmodel/iso27001/major> linkml:annotations [ skos:example "4" ;
            linkml:tag "numeric_value"^^xsd:anyURI ] ;
    linkml:description "Serious impact on objectives, reputation, or compliance." .

<https://w3id.org/lmodel/iso27001/major_nonconformity> linkml:description "Significant failure to fulfill a requirement that affects ISMS capability to achieve intended outcomes." .

<https://w3id.org/lmodel/iso27001/malware> skos:closeMatch "stix:Malware"^^xsd:anyURI ;
    skos:relatedMatch "attack:tactic_ta0002"^^xsd:anyURI ;
    linkml:description "Malicious software, including viruses, worms, trojans, and ransomware." .

<https://w3id.org/lmodel/iso27001/medium> linkml:description "Moderate risk requiring management attention and planned controls." .

<https://w3id.org/lmodel/iso27001/minor> linkml:annotations [ skos:example "2" ;
            linkml:tag "numeric_value"^^xsd:anyURI ] ;
    linkml:description "Limited impact, easily absorbed by normal operations." .

<https://w3id.org/lmodel/iso27001/minor_nonconformity> linkml:description "Isolated lapse that does not significantly affect ISMS effectiveness." .

<https://w3id.org/lmodel/iso27001/moderate> linkml:annotations [ skos:example "3" ;
            linkml:tag "numeric_value"^^xsd:anyURI ] ;
    linkml:description "Noticeable impact requiring management intervention." .

<https://w3id.org/lmodel/iso27001/modify> skos:altLabel "mitigate",
        "reduce" ;
    linkml:description "Apply controls to change the risk level (reduce likelihood or impact)." .

<https://w3id.org/lmodel/iso27001/ncname> a linkml:TypeDefinition ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"ncname\"." ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
    linkml:base "NCName" ;
    linkml:definition_uri "https://w3id.org/linkml/Ncname"^^xsd:anyURI ;
    linkml:description "Prefix part of CURIE" ;
    linkml:imported_from "linkml:types" ;
    linkml:repr "str" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/negligible> linkml:annotations [ skos:example "1" ;
            linkml:tag "numeric_value"^^xsd:anyURI ] ;
    linkml:description "No significant impact on operations or objectives." .

<https://w3id.org/lmodel/iso27001/nodeidentifier> a linkml:TypeDefinition ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"nodeidentifier\"." ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
    linkml:base "NodeIdentifier" ;
    linkml:definition_uri "https://w3id.org/linkml/Nodeidentifier"^^xsd:anyURI ;
    linkml:description "A URI, CURIE or BNODE that represents a node in a model." ;
    linkml:imported_from "linkml:types" ;
    linkml:repr "str" ;
    linkml:uri "http://www.w3.org/ns/shex#nonLiteral"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/not_applicable> skos:note "Requires justification in Statement of Applicability" ;
    linkml:description "Control excluded from scope with documented justification per 6.1.3 d)." .

<https://w3id.org/lmodel/iso27001/not_started> linkml:description "Control identified but no implementation activities begun." .

<https://w3id.org/lmodel/iso27001/objectidentifier> a linkml:TypeDefinition ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"objectidentifier\"." ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
    skos:note "Used for inheritance and type checking" ;
    linkml:base "ElementIdentifier" ;
    linkml:definition_uri "https://w3id.org/linkml/Objectidentifier"^^xsd:anyURI ;
    linkml:description "A URI or CURIE that represents an object in the model." ;
    linkml:imported_from "linkml:types" ;
    linkml:repr "str" ;
    linkml:uri "http://www.w3.org/ns/shex#iri"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/observation> skos:altLabel "opportunity_for_improvement" ;
    linkml:description "Noted condition that could lead to nonconformity if not addressed." .

<https://w3id.org/lmodel/iso27001/organizational> linkml:annotations [ skos:example "37" ;
            linkml:tag "control_count"^^xsd:anyURI ],
        [ skos:example "5" ;
            linkml:tag "annex_clause"^^xsd:anyURI ] ;
    linkml:description "Organizational controls (Annex A.5) - policies, roles, asset management, access control, supplier relationships, incident management, compliance." .

<https://w3id.org/lmodel/iso27001/other> linkml:description "Other incident type not covered by the listed categories." .

<https://w3id.org/lmodel/iso27001/people> linkml:annotations [ skos:example "6" ;
            linkml:tag "annex_clause"^^xsd:anyURI ],
        [ skos:example "8" ;
            linkml:tag "control_count"^^xsd:anyURI ] ;
    linkml:description "People controls (Annex A.6) - screening, employment terms, awareness, disciplinary process, termination responsibilities, remote working." .

<https://w3id.org/lmodel/iso27001/phishing> skos:closeMatch "capec:capec_98"^^xsd:anyURI ;
    skos:relatedMatch "attack:tactic_ta0001"^^xsd:anyURI,
        "stix:AttackPattern"^^xsd:anyURI ;
    linkml:description "Social-engineering attempt to obtain credentials or trigger malicious action." .

<https://w3id.org/lmodel/iso27001/physical> linkml:annotations [ skos:example "7" ;
            linkml:tag "annex_clause"^^xsd:anyURI ],
        [ skos:example "14" ;
            linkml:tag "control_count"^^xsd:anyURI ] ;
    linkml:description "Physical controls (Annex A.7) - perimeters, entry controls, equipment protection, secure areas, media handling, cabling, maintenance." .

<https://w3id.org/lmodel/iso27001/physical_security> linkml:description "Theft, loss, or damage of physical assets or unauthorized physical access." .

<https://w3id.org/lmodel/iso27001/plan> linkml:description "Documented approach for achieving objectives (e.g., risk treatment plan)." .

<https://w3id.org/lmodel/iso27001/planned> linkml:description "Control scheduled for implementation with defined timeline." .

<https://w3id.org/lmodel/iso27001/policy> linkml:description "High-level statement of intent and direction (e.g., IS policy per 5.2)." .

<https://w3id.org/lmodel/iso27001/policy_violation> linkml:description "Failure to comply with information security policies or procedures." .

<https://w3id.org/lmodel/iso27001/positive_finding> linkml:description "Evidence of effective implementation exceeding requirements." .

<https://w3id.org/lmodel/iso27001/possible> linkml:annotations [ skos:example "3" ;
            linkml:tag "numeric_value"^^xsd:anyURI ] ;
    linkml:description "May occur at some point (20-50% probability)." .

<https://w3id.org/lmodel/iso27001/privilege_misuse> skos:relatedMatch "attack:tactic_ta0004"^^xsd:anyURI ;
    linkml:description "Authorized user exceeding or misusing their granted privileges." .

<https://w3id.org/lmodel/iso27001/procedure> linkml:description "Documented steps for performing activities consistently." .

<https://w3id.org/lmodel/iso27001/ransomware> skos:relatedMatch "attack:tactic_ta0040"^^xsd:anyURI,
        "stix:Malware"^^xsd:anyURI ;
    linkml:description "Malware encrypting or exfiltrating data for extortion." .

<https://w3id.org/lmodel/iso27001/rare> linkml:annotations [ skos:example "1" ;
            linkml:tag "numeric_value"^^xsd:anyURI ] ;
    linkml:description "Highly unlikely to occur (< 5% probability)." .

<https://w3id.org/lmodel/iso27001/recertification> linkml:description "Third-party audit conducted to renew certification." .

<https://w3id.org/lmodel/iso27001/record> linkml:description "Evidence of activities performed or results achieved." .

<https://w3id.org/lmodel/iso27001/report> linkml:description "Formal output of assessment, audit, or review activities." .

<https://w3id.org/lmodel/iso27001/severe> linkml:annotations [ skos:example "5" ;
            linkml:tag "numeric_value"^^xsd:anyURI ] ;
    linkml:description "Catastrophic impact threatening organizational viability." .

<https://w3id.org/lmodel/iso27001/share> skos:altLabel "transfer" ;
    linkml:description "Transfer or share risk with external parties (e.g., insurance, outsourcing)." .

<https://w3id.org/lmodel/iso27001/social_engineering> linkml:description "Manipulation of people to disclose information or perform unsafe actions." .

<https://w3id.org/lmodel/iso27001/sparqlpath> a linkml:TypeDefinition ;
    dcterms:conformsTo "https://www.w3.org/TR/sparql11-query/#propertypaths" ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"." ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
    linkml:base "str" ;
    linkml:definition_uri "https://w3id.org/linkml/Sparqlpath"^^xsd:anyURI ;
    linkml:description "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF." ;
    linkml:imported_from "linkml:types" ;
    linkml:repr "str" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/standard> linkml:description "Mandatory requirements for specific technologies or processes." .

<https://w3id.org/lmodel/iso27001/supply_chain> skos:relatedMatch "attack:technique_t1195"^^xsd:anyURI ;
    linkml:description "Incident originating from a supplier, partner, or third-party component." .

<https://w3id.org/lmodel/iso27001/surveillance> linkml:description "Periodic third-party audit between certification and recertification." .

<https://w3id.org/lmodel/iso27001/technological> linkml:annotations [ skos:example "34" ;
            linkml:tag "control_count"^^xsd:anyURI ],
        [ skos:example "8" ;
            linkml:tag "annex_clause"^^xsd:anyURI ] ;
    linkml:description "Technological controls (Annex A.8) - endpoint security, access restrictions, authentication, malware protection, logging, cryptography, secure development." .

<https://w3id.org/lmodel/iso27001/time> a linkml:TypeDefinition ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\".",
        "URI is dateTime because OWL reasoners do not work with straight date or time" ;
    skos:exactMatch "schema:Time"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
    linkml:base "XSDTime" ;
    linkml:definition_uri "https://w3id.org/linkml/Time"^^xsd:anyURI ;
    linkml:description "A time object represents a (local) time of day, independent of any particular day" ;
    linkml:imported_from "linkml:types" ;
    linkml:repr "str" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#time"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/unauthorized_access> skos:relatedMatch "attack:tactic_ta0001"^^xsd:anyURI ;
    linkml:description "Access to systems or data by a party without authorization." .

<https://w3id.org/lmodel/iso27001/unlikely> linkml:annotations [ skos:example "2" ;
            linkml:tag "numeric_value"^^xsd:anyURI ] ;
    linkml:description "Not expected but possible (5-20% probability)." .

<https://w3id.org/lmodel/iso27001/uri> a linkml:TypeDefinition ;
    dcterms:conformsTo "https://www.ietf.org/rfc/rfc3987.txt" ;
    skos:closeMatch "schema:URL"^^xsd:anyURI ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"." ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
    skos:note "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node" ;
    linkml:base "URI" ;
    linkml:definition_uri "https://w3id.org/linkml/Uri"^^xsd:anyURI ;
    linkml:description "a complete URI" ;
    linkml:imported_from "linkml:types" ;
    linkml:repr "str" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .

<https://w3id.org/lmodel/iso27001/very_low> linkml:description "Negligible risk requiring no immediate action." .

<https://w3id.org/lmodel/iso27001/web_application_attack> linkml:description "Attack targeting a web application (e.g., injection, XSS, broken auth)." .

<https://w3id.org/lmodel/iso27001/AnnexAControlId> OIO:inSubset <https://w3id.org/lmodel/iso27001/annex_a_controls> ;
    skos:closeMatch "iso42001:AnnexAControlId"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
