        <https://w3id.org/lmodel/iso27001/target_implementation_date> .

<https://w3id.org/lmodel/iso27001/StatementOfApplicability> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/iso27001/annex_a_controls>,
        <https://w3id.org/lmodel/iso27001/documented_information>,
        <https://w3id.org/lmodel/iso27001/isms_core> ;
    skos:closeMatch "nist_sp_800_53:ProfileDocument"^^xsd:anyURI,
