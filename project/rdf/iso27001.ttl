<https://w3id.org/lmodel/iso27001/Organization> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/iso27001/isms_core> ;
    skos:closeMatch "ocsf:Organization"^^xsd:anyURI,
        "oscal:Party"^^xsd:anyURI,
