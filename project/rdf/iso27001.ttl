	linkml:default_prefix "iso27001" ;
	linkml:default_range <https://w3id.org/lmodel/iso27001/string> ;
	linkml:description "A LinkML model of the records an organization keeps to run an information security management system (ISMS) to ISO/IEC 27001:2022 with Amendment 1:2024: its context and scope, policies, roles and objectives, risks and their treatment, its controls and Statement of Applicability, the support and operation it needs, its audits and management reviews, and its nonconformities, corrective actions and improvements. The 93 reference controls of Annex A appear by their numbers alone." ;
	linkml:enums <https://w3id.org/lmodel/iso27001/IsmsAnnexAControl> , <https://w3id.org/lmodel/iso27001/IsmsAuditFindingType> , <https://w3id.org/lmodel/iso27001/IsmsAuditType> , <https://w3id.org/lmodel/iso27001/IsmsControlTheme> , <https://w3id.org/lmodel/iso27001/IsmsDocumentKind> , <https://w3id.org/lmodel/iso27001/IsmsImpact> , <https://w3id.org/lmodel/iso27001/IsmsImplementationStatus> , <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory> , <https://w3id.org/lmodel/iso27001/IsmsLikelihood> , <https://w3id.org/lmodel/iso27001/IsmsManagementSystemStandard> , <https://w3id.org/lmodel/iso27001/IsmsRiskLevel> , <https://w3id.org/lmodel/iso27001/IsmsRiskTreatmentOption> , <https://w3id.org/lmodel/iso27001/IsmsSecurityProperty> ;
