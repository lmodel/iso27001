<https://w3id.org/lmodel/iso27001/IsmsRecordMixin> a linkml:ClassDefinition ;
	skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
	skos:note "It is a mixin, not a base class, so that the adapt copy can re-root some record classes on LOKF's Concept and leave the others as they are: lokf adapt replaces isms_id with LOKF's id, and a class that declares id itself must descend from Concept." ;
	linkml:class_uri "https://w3id.org/lmodel/iso27001/IsmsRecordMixin"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/iso27001/IsmsRecordMixin"^^xsd:anyURI ;
	linkml:description "What every record of the ISMS has, so that other records can refer to it: an identifier, a title and a description." ;
	linkml:mixin true ;
	linkml:slot_usage _:c14n37 ;
	linkml:slots <https://w3id.org/lmodel/iso27001/IsmsRecordMixin_title> , <https://w3id.org/lmodel/iso27001/description> , <https://w3id.org/lmodel/iso27001/isms_id> .
<https://w3id.org/lmodel/iso27001/IsmsRecordMixin_title> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
	skos:mappingRelation "http://schema.org/name"^^xsd:anyURI ;
	skos:note "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." ;
	skos:prefLabel "title" ;
	linkml:definition_uri "https://w3id.org/lmodel/iso27001/title"^^xsd:anyURI ;
	linkml:description "The name the organization gives the record." ;
	linkml:domain <https://w3id.org/lmodel/iso27001/IsmsRecordMixin> ;
	linkml:domain_of <https://w3id.org/lmodel/iso27001/IsmsRecordMixin> ;
	linkml:is_a <https://w3id.org/lmodel/iso27001/title> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/iso27001/IsmsRecordMixin> ;
	linkml:pattern "^\\s*\\S" ;
	linkml:range <https://w3id.org/lmodel/iso27001/string> ;
	linkml:required true ;
	linkml:slot_uri "http://schema.org/name"^^xsd:anyURI ;
	linkml:usage_slot_name "title" .
