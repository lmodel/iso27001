<https://w3id.org/lmodel/iso27001/InterestedParty> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/iso27001/isms_core> ;
    skos:closeMatch "oscal:ResponsibleParty"^^xsd:anyURI,
        "stix:Identity"^^xsd:anyURI ;
    skos:exactMatch "iso42001:InterestedParty"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    skos:note "Captures stakeholder needs and expectations relevant to ISMS scope",
        "Reference: ISO/IEC 27001:2022 Clause 4.2 and Amd. 1:2024. ISO/IEC standards text is copyright ISO - not reproduced here.",
        "Relevant interested parties can have requirements related to climate change (Amd. 1:2024 Clause 4.2 Note 2)",
        "Requirements may include legal, regulatory, and contractual obligations" ;
    skos:relatedMatch "iso29100:PIIPrincipal"^^xsd:anyURI,
        "iso42001:CustomerRelationship"^^xsd:anyURI,
        "iso42001:SupplierRelationship"^^xsd:anyURI,
        "iso42001:ThirdPartyRelationship"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "Amd. 1:2024" ;
            linkml:tag "iso27001_amendment"^^xsd:anyURI ],
        [ a linkml:Annotation ;
            skos:example "4.2" ;
            linkml:tag "iso27001_clause"^^xsd:anyURI ] ;
    linkml:class_uri "https://w3id.org/lmodel/iso27001/InterestedParty"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/InterestedParty"^^xsd:anyURI ;
    linkml:description "A stakeholder whose needs and expectations are relevant to the ISMS per 4.2. Includes internal parties (employees, management) and external parties (customers, regulators, suppliers)." ;
    linkml:is_a <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/iso27001/NamedEntity_id>,
        <https://w3id.org/lmodel/iso27001/addressed_requirements>,
        <https://w3id.org/lmodel/iso27001/climate_change_related_requirements>,
        <https://w3id.org/lmodel/iso27001/communication_needs>,
        <https://w3id.org/lmodel/iso27001/contact_information>,
        <https://w3id.org/lmodel/iso27001/created_date>,
        <https://w3id.org/lmodel/iso27001/description>,
        <https://w3id.org/lmodel/iso27001/modified_date>,
        <https://w3id.org/lmodel/iso27001/name>,
        <https://w3id.org/lmodel/iso27001/party_type>,
        <https://w3id.org/lmodel/iso27001/relationship>,
        <https://w3id.org/lmodel/iso27001/requirements>,
        <https://w3id.org/lmodel/iso27001/version> .

<https://w3id.org/lmodel/iso27001/SoAEntry> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/iso27001/annex_a_controls> ;
    skos:closeMatch "oscal:SspImplementedRequirement"^^xsd:anyURI ;
    skos:exactMatch "iso42001:SoAEntry"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    skos:note "Each Annex A control should have a corresponding SoA entry",
        "Exclusions require documented justification" ;
    linkml:class_uri "https://w3id.org/lmodel/iso27001/SoAEntry"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/SoAEntry"^^xsd:anyURI ;
    linkml:description "A single entry in the Statement of Applicability, documenting the applicability and implementation status of one control." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/iso27001/control_reference>,
        <https://w3id.org/lmodel/iso27001/exclusion_justification>,
