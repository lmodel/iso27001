<https://w3id.org/lmodel/iso27001/isms_core> a linkml:SubsetDefinition ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    skos:note "Mandatory for any ISO 27001 conformance dataset",
        "Maps to requirement statements in the standard" ;
