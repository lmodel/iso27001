<https://w3id.org/lmodel/iso27001/Asset> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/iso27001/annex_a_controls> ;
    skos:broadMatch "iso42001:ComputingResource"^^xsd:anyURI,
        "iso42001:DataResource"^^xsd:anyURI,
        "iso42001:HumanResource"^^xsd:anyURI,
        "iso42001:ToolingResource"^^xsd:anyURI ;
    skos:closeMatch "ocsf:Device"^^xsd:anyURI,
        "oscal:SspInventoryItem"^^xsd:anyURI,
        "spdx:Package"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    skos:note "Reference: ISO/IEC 27001:2022 Annex A control 5.9; ISO/IEC 27002:2022 Clause 5.9. ISO/IEC standards text is copyright ISO - not reproduced here.",
        "Supports asset inventory, ownership, classification, and related controls" ;
    skos:relatedMatch "iso29100:PII"^^xsd:anyURI,
        "iso42001:AISystem"^^xsd:anyURI,
        "nvd:CpeMatch"^^xsd:anyURI,
        "slsa:ResourceDescriptor"^^xsd:anyURI,
        "stix:Infrastructure"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "5.9" ;
            linkml:tag "annex_a_control"^^xsd:anyURI ] ;
    linkml:class_uri "https://w3id.org/lmodel/iso27001/Asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/Asset"^^xsd:anyURI ;
    linkml:description "An information asset or associated asset requiring protection, per Annex A control 5.9." ;
    linkml:is_a <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/iso27001/NamedEntity_id>,
        <https://w3id.org/lmodel/iso27001/applicable_controls>,
