<https://w3id.org/lmodel/iso27001/DocumentedInformation> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/iso27001/documented_information> ;
    skos:closeMatch "oscal:OscalDocument"^^xsd:anyURI ;
    skos:exactMatch "iso42001:DocumentedInformation"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    skos:note "Supports identification and control metadata for managed documents",
        "Supports lifecycle, protection, and retention tracking" ;
    skos:relatedMatch "spdx:SpdxDocument"^^xsd:anyURI ;
    linkml:abstract true ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "7.5" ;
            linkml:tag "iso27001_clause"^^xsd:anyURI ] ;
    linkml:class_uri "https://w3id.org/lmodel/iso27001/DocumentedInformation"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/DocumentedInformation"^^xsd:anyURI ;
    linkml:description "Abstract class for documented information per Clause 7.5. Captures metadata required for document control." ;
    linkml:is_a <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/iso27001/NamedEntity_id>,
        <https://w3id.org/lmodel/iso27001/approved_by>,
        <https://w3id.org/lmodel/iso27001/approved_date>,
        <https://w3id.org/lmodel/iso27001/author>,
        <https://w3id.org/lmodel/iso27001/change_control_method>,
        <https://w3id.org/lmodel/iso27001/classification>,
        <https://w3id.org/lmodel/iso27001/created_date>,
        <https://w3id.org/lmodel/iso27001/description>,
        <https://w3id.org/lmodel/iso27001/distribution_controls>,
        <https://w3id.org/lmodel/iso27001/document_reference>,
        <https://w3id.org/lmodel/iso27001/document_type>,
        <https://w3id.org/lmodel/iso27001/effective_date>,
        <https://w3id.org/lmodel/iso27001/external_origin>,
        <https://w3id.org/lmodel/iso27001/external_origin_source>,
        <https://w3id.org/lmodel/iso27001/modified_date>,
        <https://w3id.org/lmodel/iso27001/name>,
        <https://w3id.org/lmodel/iso27001/owner>,
        <https://w3id.org/lmodel/iso27001/retention_period>,
        <https://w3id.org/lmodel/iso27001/review_date>,
        <https://w3id.org/lmodel/iso27001/status>,
        <https://w3id.org/lmodel/iso27001/storage_and_preservation>,
        <https://w3id.org/lmodel/iso27001/version> .

<https://w3id.org/lmodel/iso27001/InformationSecurityManagementSystem> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/iso27001/isms_core> ;
    skos:closeMatch "iso42001:AIManagementSystem"^^xsd:anyURI,
        "oscal:SystemSecurityPlan"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    skos:note "Aggregates ISMS processes and their relationships",
        "Includes explicit scope metadata and related governance artifacts",
        "Reference: ISO/IEC 27001:2022 Clause 4.4. ISO/IEC standards text is copyright ISO - not reproduced here.",
        "This is the root entity for any ISMS conformance dataset" ;
    skos:relatedMatch "cis_controls:CISControlsDocument"^^xsd:anyURI,
        "iso29100:PrivacyFramework"^^xsd:anyURI,
        "nist_csf_v2:CSFDocument"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "4.4" ;
            linkml:tag "iso27001_clause"^^xsd:anyURI ],
        [ a linkml:Annotation ;
            skos:example "true" ;
            linkml:tag "mandatory"^^xsd:anyURI ] ;
    linkml:class_uri "https://w3id.org/lmodel/iso27001/InformationSecurityManagementSystem"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/InformationSecurityManagementSystem"^^xsd:anyURI ;
    linkml:description "Top-level container representing an organization's complete ISMS per ISO 27001. Aggregates all components required to support the full ISMS lifecycle." ;
    linkml:is_a <https://w3id.org/lmodel/iso27001/NamedEntity> ;
    linkml:slot_usage [ ] ;
