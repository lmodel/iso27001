    linkml:description "Core ISMS structural elements required for conformity with Clauses 4-10. These classes represent the minimum viable data model for ISMS documentation." .

<https://w3id.org/lmodel/iso27001/CommunicationItem> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/iso27001/isms_core> ;
