<https://w3id.org/lmodel/iso27001/AuditFindingType> OIO:inSubset <https://w3id.org/lmodel/iso27001/performance_evaluation> ;
    skos:exactMatch "iso42001:AuditFindingType"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/AuditFindingType"^^xsd:anyURI ;
    linkml:description "Classification of internal audit findings." ;
    linkml:permissible_values <https://w3id.org/lmodel/iso27001/major_nonconformity>,
        <https://w3id.org/lmodel/iso27001/minor_nonconformity>,
        <https://w3id.org/lmodel/iso27001/observation>,
        <https://w3id.org/lmodel/iso27001/positive_finding> .

<https://w3id.org/lmodel/iso27001/AuditType> OIO:inSubset <https://w3id.org/lmodel/iso27001/performance_evaluation> ;
    skos:exactMatch "iso42001:AuditType"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    linkml:annotations [ skos:example "9.2" ;
            linkml:tag "iso27001_clause"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/AuditType"^^xsd:anyURI ;
    linkml:description "Classification of audits referenced by ISO/IEC 27001:2022 Clause 9.2 and ISO/IEC 17021-1 (audit programmes)." ;
    linkml:permissible_values <https://w3id.org/lmodel/iso27001/combined>,
        <https://w3id.org/lmodel/iso27001/external_second_party>,
        <https://w3id.org/lmodel/iso27001/external_third_party>,
        <https://w3id.org/lmodel/iso27001/internal>,
        <https://w3id.org/lmodel/iso27001/recertification>,
        <https://w3id.org/lmodel/iso27001/surveillance> .

