        <https://w3id.org/lmodel/iso27001/related_risks>,
        <https://w3id.org/lmodel/iso27001/version> .

<https://w3id.org/lmodel/iso27001/RiskAssessment> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/iso27001/risk_management> ;
    skos:closeMatch "iso42001:AIRiskAssessment"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    skos:note "Performed at planned intervals or when significant changes occur",
        "Reference: ISO/IEC 27001:2022 Clause 8.2. ISO/IEC standards text is copyright ISO - not reproduced here.",
