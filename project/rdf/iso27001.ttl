<https://w3id.org/lmodel/iso27001/classification> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    skos:note "Per A.5.12, classification based on confidentiality, integrity, availability" ;
