<https://w3id.org/lmodel/iso27001/RiskAssessmentProcess> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/iso27001/documented_information>,
        <https://w3id.org/lmodel/iso27001/risk_management> ;
    skos:closeMatch "iso42001:AIRiskAssessmentProcess"^^xsd:anyURI ;
