    skos:exactMatch "iso42001:Organization"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/iso27001"^^xsd:anyURI ;
    skos:note "Climate change relevance determination added by Amd. 1:2024 to Clause 4.1",
        "Context determination per 4.1 feeds into ISMS planning",
        "Reference: ISO/IEC 27001:2022 Clause 4.1 and Amd. 1:2024. ISO/IEC standards text is copyright ISO - not reproduced here." ;
