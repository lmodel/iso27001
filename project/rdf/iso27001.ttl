    linkml:definition_uri "https://w3id.org/lmodel/iso27001/DocumentedInformation"^^xsd:anyURI ;
    linkml:description "Classes representing required documented information per Clause 7.5. Supports document control and retention requirements." .

<https://w3id.org/lmodel/iso27001/effective_date> a linkml:SlotDefinition ;
