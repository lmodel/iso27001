        "iso29100:PIIProcessor"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "Amd. 1:2024" ;
            linkml:tag "iso27001_amendment"^^xsd:anyURI ],
        [ a linkml:Annotation ;
            skos:example "4.1" ;
            linkml:tag "iso27001_clause"^^xsd:anyURI ] ;
    linkml:class_uri "https://w3id.org/lmodel/iso27001/Organization"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/iso27001/Organization"^^xsd:anyURI ;
    linkml:description "The organization establishing and operating the ISMS. Captures context needed for Clause 4.1 (understanding the organization)." ;
