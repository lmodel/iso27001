<IsmsSecurityIncident> CLOSED {
    (  $<IsmsSecurityIncident_tes> (  &<IsmsSecurityEvent_tes> ;
          rdf:type [ <IsmsSecurityEvent> ] ? ;
          <affected_security_properties> [ <https://w3id.org/lmodel/iso27001/IsmsSecurityProperty#confidentiality>
             <https://w3id.org/lmodel/iso27001/IsmsSecurityProperty#integrity>
             <https://w3id.org/lmodel/iso27001/IsmsSecurityProperty#availability> ] * ;
          <incident_category> [ <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#malware>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#ransomware>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#phishing>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#social_engineering>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#unauthorized_access>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#account_compromise>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#privilege_misuse>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#data_breach>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#data_loss>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#denial_of_service>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#web_application_attack>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#supply_chain>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#insider_threat>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#physical_security>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#configuration_error>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#cryptographic_failure>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#policy_violation>
             <https://w3id.org/lmodel/iso27001/IsmsIncidentCategory#other> ] ? ;
          <incident_severity> [ <https://w3id.org/lmodel/iso27001/IsmsRiskLevel#very_low>
             <https://w3id.org/lmodel/iso27001/IsmsRiskLevel#low> <https://w3id.org/lmodel/iso27001/IsmsRiskLevel#medium>
             <https://w3id.org/lmodel/iso27001/IsmsRiskLevel#high> <https://w3id.org/lmodel/iso27001/IsmsRiskLevel#critical> ] ? ;
          <incident_detection_method> @linkml:String ? ;
          <incident_response_actions> @linkml:String * ;
          <incident_containment_actions> @linkml:String * ;
          <incident_eradication_actions> @linkml:String * ;
          <incident_recovery_actions> @linkml:String * ;
          <incident_root_cause> @linkml:String ? ;
          <incident_lessons_learned> @linkml:String * ;
          <incident_evidence> @linkml:String * ;
          <incident_notification_required> @linkml:Boolean ? ;
          <incident_notifications> @linkml:String * ;
          <incident_closed_at> @linkml:Datetime ? ;
          <incident_review> @linkml:String ?
       ) ;
       rdf:type [ <IsmsSecurityIncident> ]
    )
}

<IsmsStatementOfApplicability> CLOSED {
    (  $<IsmsStatementOfApplicability_tes> (  &<IsmsRecordMixin_tes> ;
          rdf:type [ <IsmsRecordMixin> ] ? ;
          &<IsmsDocumentControlMixin_tes> ;
          rdf:type [ <IsmsDocumentControlMixin> ] ? ;
          <soa_entries> @<IsmsApplicabilityEntry> * ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ? ;
          <document_reference> @linkml:String ? ;
          <document_version> @linkml:String ? ;
          <document_author> @linkml:String ? ;
          <document_owner> @linkml:String ? ;
          <document_approver> @linkml:String ? ;
          <document_approval_date> @linkml:Date ? ;
          <document_effective_date> @linkml:Date ? ;
          <document_last_review_date> @linkml:Date ? ;
          <document_next_review_date> @linkml:Date ? ;
          <document_status> @linkml:String ? ;
          <document_classification> @linkml:String ? ;
          <document_retention> @<IsmsDuration> ? ;
          <document_distribution> @linkml:String * ;
          <document_storage> @linkml:String ? ;
          <document_change_control> @linkml:String ? ;
          <document_external_origin> @linkml:Boolean ? ;
          <document_external_source> @linkml:String ?
       ) ;
       rdf:type [ <IsmsStatementOfApplicability> ]
    )
}

